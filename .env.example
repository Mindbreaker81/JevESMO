TYPESAFE_API_KEY=
# Deja vacio para usar el modo mock (sin llamadas reales a Jev), util para desarrollo/tests.
JEV_MODEL=jev-latest

# Capa 4.5 (auditoria Jev->Jev, JES-2/JES-3): segunda lectura que solo puede
# ANADIR motivos de revision (desacuerdo del revisor, posible manipulacion del
# texto libre). Coste: una llamada extra por caso. "0" la desactiva.
JEVESMO_AUDITORIA=1

# Como conseguir la clave:
# 1. Entra en https://console.typesafe.ai/ y crea una cuenta (o inicia sesion).
# 2. Ve al dashboard de claves: https://console.typesafe.ai/keys
# 3. Genera una API key y copiala aqui como TYPESAFE_API_KEY=sk-...
# 4. Copia este archivo a ".env" (sin ".example") en la raiz del proyecto.
#    La app y el pipeline la leen automaticamente via python-dotenv / os.environ.
# 5. Instala el SDK oficial si aun no esta: pip install typesafe-sdk
# Sin clave, la app funciona en modo MOCK (respuestas simuladas, marcadas
# explicitamente como no reales, solo para desarrollar/probar el pipeline).
