      }
     ]
    },
    {
     "not": {
      "campo": "cisplatino_apto",
      "eq": false
     }
    }
   ],
   "componentes": [
    "quimiorradioterapia",
    "quimioterapia"
   ],
   "evidencia": "I, A"
  },
  {
