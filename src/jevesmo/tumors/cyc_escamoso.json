 ],
 "derivados": [],
 "opciones": [
  {
   "id": "cirugia_o_rt_precoz",
   "label": "Cirugía o radioterapia radical monomodal",
   "nota": "Estadios I-II: cirugía conservadora o RT radical según subsitio, función y morbilidad.",
   "cuando": {
    "campo": "estadio",
    "in": [
     "I",
     "II"
    ]
   },
   "componentes": [
    "cirugia",
    "radioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "cirugia_adyuvante_observacion",
   "label": "Cirugía completa y observación/RT selectiva",
   "nota": "Tras resección R0 sin factores de riesgo mayores puede observarse o usar RT adyuvante según riesgo anatomopatológico.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "III",
      "IVA"
     ]
    },
    {
     "campo": "resecable",
     "eq": true
    },
    {
     "not": {
      "campo": "factores_alto_riesgo_postop",
      "eq": true
     }
    },
    {
     "not": {
      "campo": "factores_intermedios_postop",
      "eq": true
     }
    }
   ],
   "componentes": [
    "cirugia",
    "vigilancia"
   ],
   "evidencia": "II, B"
  },
  {
   "id": "rt_adyuvante",
   "label": "Radioterapia adyuvante postoperatoria",
   "nota": "Factores intermedios (pT3-4, pN2-3, invasión perineural/vascular) tras cirugía -> RT adyuvante.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "III",
      "IVA"
     ]
    },
    {
     "campo": "resecable",
     "eq": true
    },
    {
     "campo": "factores_intermedios_postop",
     "eq": true
    },
    {
     "not": {
      "campo": "factores_alto_riesgo_postop",
      "eq": true
     }
    }
   ],
   "componentes": [
    "radioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "qrt_adyuvante_cisplatino",
   "label": "Quimiorradioterapia adyuvante con cisplatino",
   "nota": "Margen positivo y/o extensión extranodal tras cirugía -> QRT adyuvante con cisplatino si candidato.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "III",
      "IVA"
     ]
    },
    {
     "campo": "resecable",
     "eq": true
    },
    {
     "campo": "factores_alto_riesgo_postop",
     "eq": true
    },
    {
     "not": {
      "campo": "cisplatino_apto",
      "eq": false
     }
    }
   ],
   "componentes": [
    "quimiorradioterapia",
    "quimioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "rt_adyuvante_no_cisplatino",
   "label": "RT adyuvante si no candidato a cisplatino",
   "nota": "Alto riesgo postoperatorio con cisplatino contraindicado: individualizar RT adyuvante y alternativas no cisplatino.",
