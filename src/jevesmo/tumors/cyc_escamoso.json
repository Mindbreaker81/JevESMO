     "campo": "resecable",
     "eq": true
    },
    {
     "campo": "factores_alto_riesgo_postop",
     "eq": true
    },
    {
     "campo": "cisplatino_apto",
     "eq": false
    }
   ],
   "componentes": [
    "radioterapia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "qrt_definitiva_cisplatino",
   "label": "Quimiorradioterapia definitiva con cisplatino",
