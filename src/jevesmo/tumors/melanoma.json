    {
     "campo": "braf_v600",
     "eq": "mutado"
    }
   ],
   "instrucciones": "¿Existe necesidad de respuesta rapida que favorezca iniciar BRAF/MEK frente a inmunoterapia?"
  },
  {
   "key": "cerebral_control_local",
   "tipo": "choice",
   "capa": 2,
   "cuando": {
    "campo": "metastasis_cerebrales",
    "in": [
     "asintomaticas",
     "sintomaticas"
    ]
   },
   "instrucciones": "Valora manejo inicial de metastasis cerebrales.",
   "criterios": {
    "sistemico": "Asintomaticas pequenas: tratamiento sistemico primero",
    "local": "Sintomaticas/voluminosas: SRS/cirugia/corticoides"
   }
  }
 ],
 "seguridad": [
