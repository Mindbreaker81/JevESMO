 ],
 "opciones": [
  {"id": "cirugia_conservadora_pene", "label": "Cirugia conservadora/laser/glandectomia parcial", "nota": "ESMO-EURACAN pene localizado superficial o T1 seleccionado: tratamiento conservador de organo con margenes adecuados cuando sea oncologicamente seguro.", "cuando": [{"campo": "estadio_pene", "eq": "localizado"}, {"campo": "preservacion_organo_posible", "eq": true}], "componentes": ["cirugia"], "evidencia": "III, A"},
  {"id": "penectomia_parcial_total", "label": "Penectomia parcial o total", "nota": "ESMO-EURACAN pene localizado invasivo no apto para preservacion: penectomia parcial/total con control local adecuado.", "cuando": [{"campo": "estadio_pene", "eq": "localizado"}, {"any": [{"campo": "preservacion_organo_posible", "eq": false}, {"campo": "t_primario_pene", "in": ["T3_T4"]}]}], "componentes": ["cirugia"], "evidencia": "III, A"},
  {"id": "vigilancia_ganglionar_bajo_riesgo", "label": "Vigilancia ganglionar cN0 bajo riesgo", "nota": "ESMO-EURACAN cN0 y primario de bajo riesgo: vigilancia inguinal estrecha puede ser apropiada.", "cuando": [{"campo": "estadio_pene", "eq": "localizado"}, {"campo": "estado_ganglionar_pene", "eq": "cN0"}, {"campo": "t_primario_pene", "eq": "Ta_Tis_T1a"}], "componentes": ["vigilancia"], "evidencia": "III, B"},
  {"id": "linfadenectomia_inguinal", "label": "Linfadenectomia inguinal dinamica/radical", "nota": "ESMO-EURACAN cN+ resecable o cN0 alto riesgo: estadificacion/tratamiento ganglionar inguinal temprano mejora control regional.", "cuando": [{"campo": "estadio_pene", "in": ["localizado", "ganglionar_clinico"]}, {"campo": "estado_ganglionar_pene", "in": ["cN1", "cN2"]}, {"any": [{"campo": "bulky_nodes", "eq": false}, {"campo": "bulky_nodes", "missing": true}]}], "componentes": ["cirugia"], "evidencia": "III, A"},
  {"id": "tip_neoadyuvante_pene", "label": "Quimioterapia neoadyuvante TIP", "nota": "ESMO-EURACAN enfermedad ganglionar bulky cN2/cN3 o localmente avanzada resecable: TIP neoadyuvante seguido de linfadenectomia/cirugia si responde.", "cuando": [{"campo": "estadio_pene", "in": ["ganglionar_clinico", "localmente_avanzado"]}, {"any": [{"campo": "bulky_nodes", "eq": true}, {"campo": "estado_ganglionar_pene", "eq": "cN3"}]}, {"campo": "cisplatino_elegible_pene", "eq": true}], "componentes": ["quimioterapia", "cirugia"], "evidencia": "III, B"},
  {"id": "cirugia_rescate_post_tip", "label": "Cirugia de consolidacion/rescate post-QT", "nota": "ESMO-EURACAN tras respuesta a TIP neoadyuvante: reseccion del primario/ganglios residuales en centro experto.", "cuando": [{"campo": "estadio_pene", "in": ["ganglionar_clinico", "localmente_avanzado"]}, {"campo": "tratamientos_previos", "contains": "TIP"}, {"campo": "tumor_resecable", "eq": true}], "componentes": ["cirugia"], "evidencia": "III, B"},
  {"id": "qt_paliativa_platino_pene", "label": "Quimioterapia sistemica paliativa con platino-taxano/5FU", "nota": "ESMO-EURACAN metastasico o irresecable: quimioterapia basada en cisplatino (TIP/TPF o cisplatino-5FU) si fit.", "cuando": [{"campo": "estadio_pene", "eq": "metastasico"}, {"any": [{"campo": "lineas_previas", "missing": true}, {"campo": "lineas_previas", "eq": 0}]}, {"campo": "cisplatino_elegible_pene", "eq": true}], "componentes": ["quimioterapia"], "evidencia": "III, B"},
  {"id": "qt_no_cis_pene", "label": "Quimioterapia paliativa no cisplatino / soporte individualizado", "nota": "ESMO-EURACAN metastasico no elegible a cisplatino: regimen menos intensivo o soporte segun ECOG y objetivos.", "cuando": [{"campo": "estadio_pene", "eq": "metastasico"}, {"campo": "cisplatino_elegible_pene", "eq": false}], "componentes": ["quimioterapia", "soporte"], "evidencia": "IV, B"},
  {"id": "inmunoterapia_biomarcador_pene", "label": "Pembrolizumab u otra inmunoterapia por MSI-H/TMB alto", "nota": "ESMO-EURACAN avanzado pretratado con MSI-H/dMMR/TMB alto: inmunoterapia puede considerarse segun aprobacion tumor-agnostica.", "cuando": [{"campo": "estadio_pene", "eq": "metastasico"}, {"campo": "msi_tmb_alto", "eq": true}, {"campo": "lineas_previas", "gte": 1}], "componentes": ["inmunoterapia"], "evidencia": "IV, B"},
  {"id": "soporte_pene", "label": "Soporte y control sintomatico", "nota": "ESMO-EURACAN: ECOG 3-4, irresecabilidad no tratable o toxicidad prohibitiva -> cuidados paliativos, control local de sintomas y soporte.", "cuando": [{"campo": "ecog", "in": ["3", "4"]}], "componentes": ["soporte"], "evidencia": "V, A"}
 ],
