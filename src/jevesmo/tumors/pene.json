  {"id": "estadio_pene", "label": "Estadio/entorno", "tipo": "choice", "opciones": ["localizado", "ganglionar_clinico", "localmente_avanzado", "metastasico"], "requerido": true, "pregunta": "¿Cual es el entorno (localizado, ganglionar clinico, localmente avanzado o metastasico)?"},
  {"id": "t_primario_pene", "label": "Tumor primario", "tipo": "choice", "opciones": ["Ta_Tis_T1a", "T1b_T2", "T3_T4"], "seccion": "Tumor"},
  {"id": "estado_ganglionar_pene", "label": "Ganglios", "tipo": "choice", "opciones": ["cN0", "cN1", "cN2", "cN3"], "seccion": "Ganglios"},
  {"id": "tumor_resecable", "label": "Tumor resecable", "tipo": "bool", "seccion": "Tratamiento local"},
