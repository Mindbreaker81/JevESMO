{"id":"cpm","nombre":"Cáncer de pulmón microcítico","grupo":"Torácico","version":"CPM-ESMO-2025.1","guias":[{"titulo":"Small-cell lung cancer: ESMO Clinical Practice Guideline","anio":2021,"url":"https://www.esmo.org/guidelines/lung-and-chest-tumours/small-cell-lung-cancer"},{"titulo":"ESMO Living Guideline: small-cell lung cancer","anio":2025,"url":"https://www.esmo.org/guidelines/living-guidelines"}],"descripcion":"CPM limitado y extenso: QRT, consolidación durvalumab, quimio-inmunoterapia y rescate.","campos":[{"id":"extension","label":"Extensión","tipo":"choice","opciones":[{"id":"limitado","label":"enfermedad limitada"},{"id":"extenso","label":"enfermedad extensa"}],"requerido":true,"pregunta":"¿Es enfermedad limitada o extensa?"},{"id":"candidato_qrt_concurrente","label":"Candidato a QRT concurrente","tipo":"bool","requerido_si":{"campo":"extension","eq":"limitado"},"pregunta":"¿El paciente con enfermedad limitada es candidato a quimiorradioterapia concurrente?"},{"id":"respuesta_tras_qrt","label":"Sin progresión tras QRT","tipo":"bool","seccion":"Tratamiento previo"},{"id":"intervalo_recaida","label":"Intervalo libre de platino","tipo":"choice","opciones":["sensible_90d","refractario_90d","no_aplica"],"seccion":"Historial"},{"id":"metastasis_cerebrales","label":"Metástasis cerebrales","tipo":"bool","seccion":"Extensión"},{"id":"enfermedad_autoinmune_activa","label":"Enfermedad autoinmune activa","tipo":"bool","seccion":"Seguridad"},{"id":"neumonitis_o_epi","label":"Neumonitis/EPI significativa","tipo":"bool","seccion":"Seguridad"}],"derivados":[{"id":"linea","label":"Línea terapéutica","defecto":"primera linea","reglas":[{"cuando":{"campo":"lineas_previas","gte":1},"valor":"recaida/progresion"}]}],"opciones":[{"id":"qrt_concurrente_limitado","label":"Cisplatino/etoposido + RT torácica concurrente","nota":"ESMO: CPM limitado ECOG 0-2 apto -> quimiorradioterapia concurrente temprana con platino-etoposido.","cuando":[{"campo":"extension","eq":"limitado"},{"campo