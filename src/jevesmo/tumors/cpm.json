neumonitis_rt_ici","cuando":{"campo":"neumonitis_o_epi","eq":true},"bloquea_componentes":["quimiorradioterapia","inmunoterapia"],"instrucciones":"Con neumonitis/EPI significativa, ¿es inaceptable QRT torácica o durvalumab?","motivo":"Neumonitis/EPI: riesgo pulmonar alto."}],"avisos":[{"cuando":{"campo":"intervalo_recaida","missing":true},"texto":"Intervalo libre de platino no registrado: condiciona reinducción frente a fármacos de rescate."},{"cuando":{"campo":"metastasis_cerebrales","missing":true},"texto":"Estado CNS no disponible: RM cerebral influye en PCI/vigilancia y RT."}],"vinetas":[{"id":"CPM-V01","titulo":"Limitado apto QRT","fuente":"ESMO SCLC: QRT concurrente","payload":{"edad":59,"sexo":"hombre","ecog":"1","extension":"limitado","candidato_qrt_concurrente":true},"esperado":{"tipo":"recomendacion","preferida":"qrt_concurrente_limitado","aceptables":["qrt_concurrente_limitado"]}},{"id":"CPM-V02","titulo":"Limitado tras QRT sin progresión","fuente":"ADRIATIC: durvalumab consolidacion","payload":{"edad":62,"sexo":"mujer","ecog":"0","extension":"limitado","candidato_qrt_concurrente":true,"respuesta_tras_qrt":true,"tratamientos_previos":["cisplatino-etoposido + RT concurrente"]},"esperado":{"tipo":"recomendacion","preferida":"durvalumab_adriatic","aceptables":["durvalumab_adriatic","pci_o_rm"]}},{"id":"CPM-V03","titulo":"Extenso primera línea","fuente":"IMpower133/CASPIAN","payload":{"edad":67,"sexo":"hombre","ecog":"1","extension":"extenso","lineas_previas":0},"esperado":{"tipo":"recomendacion","preferida":"platino_etoposido_ici_extenso","aceptables":["platino_etoposido_ici_extenso","platino_etoposido_solo"]}},{"id":"CPM-V04","titulo":"Recaída sensible","fuente":"ESMO SCLC recaida sensible","payload":{"edad":64,"sexo":"mujer","ecog":"1","extension":"extenso","lineas_previas":1,"intervalo_recaida":"sensible_90d","tratamientos_previos":["carboplatino-etoposido-atezolizumab"]},"esperado":{"tipo":"recomendacion","preferida":"reinduccion_platino","aceptables":["r