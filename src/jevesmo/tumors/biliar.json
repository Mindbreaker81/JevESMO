 "opciones": [
  {
   "id": "cirugia_reseccion",
   "label": "Resección quirúrgica con linfadenectomía",
   "nota": "ESMO: enfermedad localizada resecable -> cirugía radical si posible en centro hepatobiliar",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "resecable"
    },
    {
     "not": {
      "campo": "post_reseccion",
      "eq": true
     }
    }
   ],
   "componentes": [
    "cirugia"
   ],
   "evidencia": "III, A"
  },
  {
   "id": "capecitabina_adyuvante",
   "label": "Capecitabina adyuvante 6 meses",
   "nota": "ESMO: tras resección de vías biliares -> capecitabina adyuvante 6 meses (BILCAP)",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "resecable"
    },
    {
     "campo": "post_reseccion",
     "eq": true
    }
   ],
   "componentes": [
    "quimioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "gemcis_durva_1l",
   "label": "Gemcitabina-cisplatino + durvalumab",
   "nota": "ESMO: irresecable/metastasico 1L apto cisplatino -> gem-cis + durvalumab (TOPAZ-1)",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "irresecable_metastasico"
    },
    {
