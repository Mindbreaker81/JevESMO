       "missing": true
      },
      {
       "campo": "lineas_previas",
       "eq": 0
      }
     ]
    },
    {
     "not": {
      "campo": "cisplatino_apto",
      "eq": false
     }
    }
   ],
   "componentes": [
    "quimioterapia",
    "inmunoterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "gemcis_pembro_1l",
