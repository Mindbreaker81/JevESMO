{
 "id": "llc",
 "nombre": "Leucemia linfocítica crónica",
 "grupo": "Hematología",
 "version": "CLL-ESMO-2024.1",
 "guias": [
  {
   "titulo": "ESMO Clinical Practice Guideline: Chronic lymphocytic leukaemia",
   "anio": 2024,
   "url": "https://www.esmo.org/guidelines/haematological-malignancies/chronic-lymphocytic-leukaemia"
  }
 ],
 "descripcion": "LLC: indicación iwCLL, Binet/Rai, TP53/del17p, IGHV, BTKi continuo frente a venetoclax-obinutuzumab y recaída.",
 "campos": [
  {
   "id": "estadio_cll",
   "label": "Estadio Binet/Rai",
   "tipo": "choice",
   "opciones": [
    "Binet_A_Rai_0_I",
    "Binet_B_Rai_II",
    "Binet_C_Rai_III_IV"
   ],
   "requerido": true,
   "pregunta": "¿Cuál es el estadio Binet/Rai?"
  },
  {
   "id": "indicacion_iwcll",
   "label": "Indicación iwCLL de tratamiento",
   "tipo": "bool",
   "requerido": true,
   "pregunta": "¿Cumple criterios iwCLL para iniciar tratamiento?"
  },
  {
   "id": "tp53_del17p",
   "label": "TP53 mutado o del(17p)",
   "tipo": "choice",
   "opciones": [
    "alterado",
    "no_alterado",
    "desconocido"
   ],
   "requerido_si": {
    "campo": "indicacion_iwcll",
    "eq": true
   },
   "pregunta": "¿Hay mutación TP53 o deleción 17p?"
  },
  {
   "id": "ighv",
   "label": "IGHV",
   "tipo": "choice",
   "opciones": [
    "mutado",
    "no_mutado",
    "desconocido"
   ],
   "requerido_si": {
    "campo": "indicacion_iwcll",
    "eq": true
   },
   "pregunta": "¿Cuál es el estado IGHV?"
  },
  {
   "id": "cardiopatia_anticoagulacion",
   "label": "Cardiopatía significativa o anticoagulación",
   "tipo": "bool",
   "seccion": "Seguridad"
  },
  {
   "id": "preferencia_tiempo_fijo",
   "label": "Preferencia por tratamiento de duración fija",
   "tipo": "bool",
   "seccion": "Preferencias"
  }
 ],
 "derivados": [
  {
   "id": "situacion",
   "label": "Situación clínica",
   "defecto": "primera_linea",
   "reglas": [
    {
     "cuando": {
      "campo": "lineas_previas",
      "gte": 1
     },
     "valor": "recaida"
    }
   ]
  }
 ],
 "opciones": [
  {
   "id": "observacion",
   "label": "Observación activa",
   "nota": "ESMO CLL: sin criterios iwCLL de tratamiento -> watch and wait, incluso en estadios iniciales",
   "cuando": [
    {
     "campo": "indicacion_iwcll",
     "eq": false
    }
   ],
   "componentes": [
    "vigilancia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "btki_1l",
   "label": "Inhibidor BTK covalente continuo (acalabrutinib/zanubrutinib/ibrutinib)",
   "nota": "ESMO CLL: primera línea con iwCLL, especialmente TP53/del17p o IGHV no mutado; BTKi continuo evita quimio",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "primera_linea"
    },
    {
     "campo": "indicacion_iwcll",
     "eq": true
    },
    {
     "not": {
      "campo": "cardiopatia_anticoagulacion",
      "eq": true
     }
    }
   ],
   "componentes": [
    "dirigida"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "ven_obinu_1l",
   "label": "Venetoclax + obinutuzumab tiempo fijo",
   "nota": "ESMO CLL: primera línea sin TP53 alterado o si se prioriza duración fija; CLL14",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "primera_linea"
    },
    {
     "campo": "indicacion_iwcll",
     "eq": true
    },
    {
     "not": {
      "campo": "tp53_del17p",
      "eq": "alterado"
     }
    }
   ],
   "componentes": [
    "dirigida",
    "inmunoterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "ven_obinu_tp53",
   "label": "Venetoclax + obinutuzumab si BTKi no adecuado",
   "nota": "ESMO CLL: TP53/del17p con contraindicación/preferencia contra BTKi -> venetoclax-obinutuzumab puede ser opción",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "primera_linea"
    },
    {
     "campo": "indicacion_iwcll",
     "eq": true
    },
    {
     "campo": "tp53_del17p",
     "eq": "alterado"
    },
    {
     "campo": "cardiopatia_anticoagulacion",
     "eq": true
    }
   ],
   "componentes": [
    "dirigida",
    "inmunoterapia"
   ],
   "evidencia": "II, B"
  },
  {
   "id": "ven_ibrutinib_1l",
   "label": "Venetoclax + ibrutinib tiempo fijo",
   "nota": "ESMO CLL: opción de duración fija oral en primera línea seleccionada (GLOW/CAPTIVATE), si no hay alto riesgo cardiovascular",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "primera_linea"
    },
    {
     "campo": "indicacion_iwcll",
     "eq": true
    },
    {
     "campo": "preferencia_tiempo_fijo",
     "eq": true
    },
    {
     "not": {
      "campo": "cardiopatia_anticoagulacion",
      "eq": true
     }
    }
   ],
   "componentes": [
    "dirigida"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "fitcr_ighv_mutado",
   "label": "FCR/BR solo en casos seleccionados IGHV mutado",
   "nota": "ESMO CLL: inmunoquimioterapia restringida a jovenes/fit con IGHV mutado, TP53 normal y decisión informada",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "primera_linea"
    },
    {
     "campo": "indicacion_iwcll",
     "eq": true
    },
    {
     "campo": "ighv",
     "eq": "mutado"
    },
    {
     "campo": "tp53_del17p",
     "eq": "no_alterado"
    },
    {
     "campo": "edad",
     "lt": 65
    }
   ],
   "componentes": [
    "quimioterapia",
    "inmunoterapia"
   ],
   "evidencia": "II, B"
  },
  {
   "id": "venetoclax_recaida_post_btki",
   "label": "Venetoclax + rituximab/obinutuzumab tras BTKi",
   "nota": "ESMO CLL: recaída/progresion tras BTKi -> cambiar a venetoclax basado en anti-CD20 si procede",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "recaida"
    },
    {
     "campo": "tratamientos_previos",
     "contains": "BTK"
    }
   ],
   "componentes": [
    "dirigida",
    "inmunoterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "btki_recaida_post_ven",
   "label": "BTKi covalente o no covalente tras venetoclax",
   "nota": "ESMO CLL: recaída tras venetoclax sin exposición a BTKi -> acalabrutinib/zanubrutinib; tras BTKi considerar pirtobrutinib/ensayo",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "recaida"
    },
    {
     "campo": "tratamientos_previos",
     "contains": "venetoclax"
    }
   ],
   "componentes": [
    "dirigida"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "pirtobrutinib_ensayo",
   "label": "Pirtobrutinib/ensayo clínico en doble expuesto",
   "nota": "ESMO CLL: recaída tras BTKi y venetoclax -> inhibidor BTK no covalente, ensayo o terapia celular si disponible",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "recaida"
    },
    {
     "campo": "tratamientos_previos",
     "contains": "BTK"
    },
    {
     "campo": "tratamientos_previos",
     "contains": "venetoclax"
    }
   ],
   "componentes": [
    "dirigida"
   ],
   "evidencia": "III, B"
  }
 ],
 "preguntas": [
  {
   "key": "iwcll_limite",
   "tipo": "noul",
   "capa": 1,
   "cuando": {
    "campo": "indicacion_iwcll",
    "eq": true
   },
   "instrucciones": "¿La indicación iwCLL es clara y no se debe a causas reversibles?"
  },
  {
   "key": "preferencia_continuo_vs_fijo",
   "tipo": "choice",
   "capa": 1,
   "cuando": {
    "campo": "indicacion_iwcll",
    "eq": true
   },
   "instrucciones": "Si hay varias opciones, ¿qué estrategia encaja mejor?",
   "criterios": {
    "continuo": "Tratamiento continuo oral con BTKi",
    "fijo": "Duración fija con venetoclax-obinutuzumab/venetoclax-ibrutinib"
   }
  }
 ],
 "seguridad": [
  {
   "key": "riesgo_btki",
   "cuando": {
    "campo": "cardiopatia_anticoagulacion",
    "eq": true
   },
   "bloquea": [
    "btki_1l",
    "ven_ibrutinib_1l",
    "btki_recaida_post_ven"
   ],
   "instrucciones": "Con fibrilación auricular, insuficiencia cardiaca, hipertensión no controlada o anticoagulación, ¿el riesgo de BTKi es inaceptable?",
   "umbral": 0.55,
   "motivo": "Riesgo cardiovascular/hemorragico alto con BTKi"
  },
  {
   "key": "tls_venetoclax",
   "cuando": {
    "campo": "insuficiencia_renal",
    "eq": true
   },
   "bloquea_componentes": [
    "dirigida"
   ],
   "instrucciones": "¿El riesgo de lisis tumoral/insuficiencia renal hace inseguro iniciar venetoclax u otra terapia dirigida sin medidas especializadas?",
   "umbral": 0.8,
   "motivo": "Riesgo de lisis tumoral/renal requiere manejo especializado"
  }
 ],
 "avisos": [
  {
   "cuando": {
    "campo": "tp53_del17p",
    "eq": "desconocido"
   },
   "texto": "TP53/del17p desconocido: debe testarse antes de primera línea o recaída."
  },
  {
   "cuando": {
    "campo": "ighv",
    "eq": "desconocido"
   },
   "texto": "IGHV desconocido: modifica duración esperada de respuesta y evita inmunoquimioterapia inapropiada."
  }
 ],
