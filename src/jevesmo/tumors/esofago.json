    {
     "campo": "histologia",
     "eq": "adenocarcinoma"
    },
    {
     "campo": "lineas_previas",
     "gte": 1
    }
   ],
   "componentes": [
    "antiangiogenico",
    "quimioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "taxano_irinotecan_2l",
   "label": "Taxano o irinotecan 2a linea",
   "nota": "ESMO: enfermedad avanzada tras platino-fluoropirimidina si no candidato a ramucirumab o escamoso -> taxano o irinotecan",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "metastasico"
    },
    {
     "campo": "lineas_previas",
     "gte": 1
    }
   ],
   "componentes": [
    "quimioterapia"
   ],
   "evidencia": "I, B"
  }
 ],
 "preguntas": [
  {
   "key": "fit_trimodal",
   "tipo": "noul",
   "capa": 1,
   "cuando": {
    "campo": "situacion",
    "eq": "localizado_resecable"
   },
   "instrucciones": "¿El paciente es suficientemente fit para tratamiento trimodal o FLOT perioperatorio y cirugia?"
  },
  {
   "key": "pd_l1_util",
   "tipo": "score",
   "capa": 2,
   "cuando": [
    {
     "campo": "situacion",
     "eq": "metastasico"
    },
    {
     "campo": "pdl1_cps",
     "gte": 1
    },
    {
     "campo": "pdl1_cps",
     "lt": 10
    }
   ],
   "instrucciones": "PD-L1 CPS intermedio/bajo: estima beneficio de inmunoterapia",
   "criterios": [
    "baja",
    "incierta",
    "alta"
   ]
  }
 ],
 "seguridad": [
  {
   "key": "autoinmune_ici",
   "cuando": {
    "campo": "comorbilidades_relevantes",
    "contains": "autoinmune"
   },
   "bloquea_componentes": [
    "inmunoterapia"
   ],
   "instrucciones": "Con enfermedad autoinmune activa o inmunosupresion relevante, ¿es inaceptable el riesgo de PD-1/PD-L1?",
   "motivo": "Riesgo autoinmune inaceptable para inmunoterapia"
  },
  {
   "key": "cardiaco_her2",
   "cuando": {
    "campo": "fevi",
    "present": true
   },
   "bloquea_componentes": [
    "anti_her2"
   ],
   "instrucciones": "Segun FEVI e historia cardiaca, ¿trastuzumab supone riesgo cardiaco inaceptable?",
   "motivo": "Riesgo cardiaco para anti-HER2"
  }
 ],
 "avisos": [
  {
   "cuando": [
