  }
 ],
 "descripcion": "Escamoso y adenocarcinoma de esofago/union EG: CROSS, FLOT, QRT definitiva, nivolumab adyuvante y avanzado segun HER2, PD-L1, MSI y Claudin 18.2.",
 "campos": [
  {
   "id": "situacion",
   "label": "Situacion clinica",
   "tipo": "choice",
   "seccion": "Tumor",
   "opciones": [
    "mucosa_temprana",
    "localizado_resecable",
    "localmente_avanzado_irresecable",
    "metastasico"
   ],
   "requerido": true,
   "pregunta": "¿Cual es la situacion: mucosa temprana, localizado resecable, localmente avanzado irresecable o metastasico?"
  },
  {
   "id": "histologia",
   "label": "Histologia",
   "tipo": "choice",
   "seccion": "Tumor",
   "opciones": [
    "escamoso",
    "adenocarcinoma"
   ],
   "requerido": true,
   "pregunta": "¿La histologia es escamosa o adenocarcinoma?"
  },
  {
   "id": "localizacion",
   "label": "Localizacion",
   "tipo": "choice",
   "seccion": "Tumor",
   "opciones": [
    "cervical",
    "toracico",
    "union_eg",
    "gastrico_cardias"
   ],
   "requerido": true,
   "pregunta": "¿Localizacion dominante: cervical, toracico, union EG o cardias gastrico?"
  },
  {
   "id": "t_nm",
   "label": "T clinico",
   "tipo": "choice",
   "seccion": "Tumor",
   "opciones": [
    "T1a",
    "T1b",
    "T2",
    "T3",
    "T4a",
    "T4b"
   ]
  },
  {
   "id": "n_positivo",
   "label": "Ganglios clinicamente positivos",
   "tipo": "bool",
   "seccion": "Tumor"
  },
  {
   "id": "residual_post_neoadyuvancia",
   "label": "Enfermedad residual tras neoadyuvancia y cirugia R0",
   "tipo": "bool",
   "seccion": "Tumor"
  },
  {
   "id": "her2",
   "label": "HER2",
   "tipo": "choice",
   "seccion": "Biomarcadores",
   "opciones": [
    "positivo",
    "negativo",
    "desconocido"
   ]
  },
  {
   "id": "pdl1_cps",
   "label": "PD-L1 CPS",
   "tipo": "number",
   "seccion": "Biomarcadores",
   "min": 0,
   "max": 100
  },
  {
   "id": "msi",
   "label": "MSI/MMR",
   "tipo": "choice",
   "seccion": "Biomarcadores",
   "opciones": [
    "msi_h",
    "pmmr",
    "desconocido"
   ]
  },
  {
   "id": "claudin182",
   "label": "Claudin 18.2",
   "tipo": "choice",
   "seccion": "Biomarcadores",
   "opciones": [
    "positivo",
    "negativo",
    "desconocido"
   ]
  },
  {
   "id": "fevi",
   "label": "FEVI",
   "tipo": "number",
   "seccion": "Seguridad",
   "min": 0,
   "max": 100,
   "unidad": "%"
  }
 ],
 "derivados": [
  {
   "id": "enfoque",
   "label": "Enfoque terapeutico",
   "defecto": "sistemico",
   "reglas": [
    {
     "cuando": {
      "campo": "situacion",
      "in": [
       "mucosa_temprana",
       "localizado_resecable"
      ]
     },
     "valor": "curativo"
    },
    {
     "cuando": {
      "campo": "situacion",
      "eq": "localmente_avanzado_irresecable"
     },
     "valor": "definitivo_no_quirurgico"
    }
   ]
  }
 ],
 "opciones": [
  {
   "id": "reseccion_endoscopica",
   "label": "Reseccion endoscopica",
   "nota": "ESMO: T1a superficial sin alto riesgo puede tratarse con reseccion endoscopica en centro experto",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "mucosa_temprana"
    }
   ],
   "componentes": [
    "cirugia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "cirugia_primaria",
   "label": "Cirugia primaria con linfadenectomia",
   "nota": "ESMO: T1b/T2 N0 de bajo riesgo puede ir a cirugia primaria",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "localizado_resecable"
    },
    {
     "campo": "t_nm",
     "in": [
      "T1b",
      "T2"
     ]
    },
    {
     "campo": "n_positivo",
     "eq": false
    }
   ],
   "componentes": [
    "cirugia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "cross_trimodal",
   "label": "QRT neoadyuvante CROSS seguida de cirugia",
   "nota": "ESMO: enfermedad resecable localmente avanzada de esofago/union EG, especialmente escamoso o adenocarcinoma esofagico: carboplatino-paclitaxel y RT preoperatoria seguida de cirugia",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "localizado_resecable"
    },
    {
     "campo": "histologia",
     "in": [
      "escamoso",
      "adenocarcinoma"
     ]
    }
   ],
   "componentes": [
    "quimiorradioterapia",
    "cirugia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "flot_perioperatorio",
   "label": "FLOT perioperatorio",
   "nota": "ESMO: adenocarcinoma resecable de union EG/cardias gastrico cT2 o N+ -> quimioterapia perioperatoria FLOT",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "localizado_resecable"
    },
    {
     "campo": "histologia",
     "eq": "adenocarcinoma"
    },
    {
     "campo": "localizacion",
     "in": [
      "union_eg",
      "gastrico_cardias"
     ]
    }
   ],
   "componentes": [
    "quimioterapia",
    "cirugia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "qrt_definitiva",
   "label": "Quimiorradioterapia definitiva",
   "nota": "ESMO: escamoso cervical/toracico no quirurgico, irresecable o no candidato a cirugia -> QRT definitiva",
   "cuando": [
    {
     "any": [
      {
       "campo": "situacion",
       "eq": "localmente_avanzado_irresecable"
      },
      {
       "campo": "localizacion",
       "eq": "cervical"
      }
     ]
    },
    {
     "campo": "histologia",
     "eq": "escamoso"
    }
   ],
   "componentes": [
    "quimiorradioterapia"
   ],
   "evidencia": "I, B"
  },
  {
   "id": "nivolumab_adyuvante",
   "label": "Nivolumab adyuvante",
   "nota": "ESMO: tras QRT neoadyuvante y cirugia R0 con enfermedad residual -> nivolumab adyuvante (CheckMate 577)",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "localizado_resecable"
    },
    {
     "campo": "residual_post_neoadyuvancia",
     "eq": true
    }
   ],
   "componentes": [
    "inmunoterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "pembro_trastu_quimio_1l",
   "label": "Pembrolizumab + trastuzumab + quimioterapia",
   "nota": "ESMO: adenocarcinoma avanzado HER2 positivo 1L -> trastuzumab y pembrolizumab con platino-fluoropirimidina",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "metastasico"
    },
    {
     "campo": "histologia",
     "eq": "adenocarcinoma"
    },
    {
     "campo": "her2",
     "eq": "positivo"
    },
    {
     "any": [
      {
       "campo": "lineas_previas",
       "missing": true
      },
      {
       "campo": "lineas_previas",
       "eq": 0
      }
     ]
    }
   ],
   "componentes": [
    "quimioterapia",
    "inmunoterapia",
    "anti_her2"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "ici_quimio_cps_alto",
   "label": "Inmunoterapia + quimioterapia por PD-L1 alto",
   "nota": "ESMO: enfermedad avanzada con PD-L1 CPS alto (CPS>=10) -> pembrolizumab/nivolumab + quimioterapia",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "metastasico"
    },
    {
     "campo": "pdl1_cps",
     "gte": 10
    },
    {
     "any": [
      {
       "campo": "lineas_previas",
       "missing": true
      },
      {
       "campo": "lineas_previas",
       "eq": 0
      }
     ]
    }
   ],
   "componentes": [
    "quimioterapia",
    "inmunoterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "zolbetuximab_quimio",
   "label": "Zolbetuximab + quimioterapia",
   "nota": "ESMO/Living: adenocarcinoma avanzado HER2 negativo, CLDN18.2 positivo, 1L -> zolbetuximab + CAPOX/FOLFOX",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "metastasico"
    },
    {
     "campo": "histologia",
     "eq": "adenocarcinoma"
    },
    {
     "campo": "her2",
     "ne": "positivo"
    },
    {
     "campo": "claudin182",
     "eq": "positivo"
    },
    {
     "any": [
      {
       "campo": "lineas_previas",
       "missing": true
      },
      {
       "campo": "lineas_previas",
       "eq": 0
      }
     ]
    }
   ],
   "componentes": [
    "quimioterapia",
    "dirigida"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "ici_msi_h",
   "label": "Inmunoterapia para MSI-H/dMMR",
   "nota": "ESMO: tumor avanzado MSI-H/dMMR puede recibir inhibidor PD-1",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "metastasico"
    },
    {
     "campo": "msi",
     "eq": "msi_h"
    }
   ],
   "componentes": [
    "inmunoterapia"
   ],
   "evidencia": "II, B"
  },
  {
   "id": "quimio_doblete_1l",
   "label": "Quimioterapia doblete platino-fluoropirimidina",
   "nota": "ESMO: enfermedad avanzada sin biomarcador accionable o PD-L1 bajo -> doblete platino-fluoropirimidina",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "metastasico"
    },
    {
     "any": [
      {
       "campo": "lineas_previas",
       "missing": true
      },
      {
       "campo": "lineas_previas",
       "eq": 0
      }
     ]
    }
   ],
   "componentes": [
    "quimioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "ram_paclitaxel_2l",
   "label": "Ramucirumab + paclitaxel 2a linea",
   "nota": "ESMO: adenocarcinoma esofagogastrico avanzado tras 1L -> ramucirumab + paclitaxel (RAINBOW)",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "metastasico"
