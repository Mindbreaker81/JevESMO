  {"key": "centro_experto_rescate", "tipo": "noul", "capa": 2, "cuando": {"campo": "estadio_tg", "eq": "recaida"}, "instrucciones": "¿Debe remitirse a centro experto para altas dosis o ensayo por recaida compleja?"}
