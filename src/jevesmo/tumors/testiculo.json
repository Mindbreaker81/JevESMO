 ],
 "opciones": [
  {"id": "seminoma_I_vigilancia", "label": "Seminoma I: vigilancia", "nota": "ESMO seminoma estadio I tras orquiectomia: vigilancia es opcion preferida si adherencia adecuada; evita sobretratamiento.", "cuando": [{"campo": "histologia_tg", "eq": "seminoma"}, {"campo": "estadio_tg", "eq": "I"}, {"any": [{"campo": "candidato_vigilancia", "missing": true}, {"campo": "candidato_vigilancia", "eq": true}]}], "componentes": ["vigilancia"], "evidencia": "I, A"},
  {"id": "seminoma_I_carboplatino", "label": "Seminoma I: carboplatino AUC7 x1", "nota": "ESMO seminoma estadio I: carboplatino adyuvante x1 puede ofrecerse si vigilancia no es adecuada o por factores de riesgo/preferencia.", "cuando": [{"campo": "histologia_tg", "eq": "seminoma"}, {"campo": "estadio_tg", "eq": "I"}, {"campo": "candidato_vigilancia", "eq": false}], "componentes": ["quimioterapia"], "evidencia": "I, B"},
  {"id": "nsgct_I_vigilancia", "label": "No seminoma I: vigilancia", "nota": "ESMO NSGCT estadio I sin invasion linfovascular y adherente: vigilancia es estandar preferido.", "cuando": [{"campo": "histologia_tg", "in": ["no_seminoma", "mixto"]}, {"campo": "estadio_tg", "eq": "I"}, {"any": [{"campo": "invasion_linfovascular", "eq": false}, {"campo": "invasion_linfovascular", "missing": true}]}, {"any": [{"campo": "candidato_vigilancia", "missing": true}, {"campo": "candidato_vigilancia", "eq": true}]}], "componentes": ["vigilancia"], "evidencia": "I, A"},
  {"id": "nsgct_I_bep1", "label": "No seminoma I alto riesgo: BEP x1", "nota": "ESMO NSGCT estadio I con invasion linfovascular o vigilancia inadecuada: BEP x1 reduce recaidas; RPLND en centros expertos es alternativa seleccionada.", "cuando": [{"campo": "histologia_tg", "in": ["no_seminoma", "mixto"]}, {"campo": "estadio_tg", "eq": "I"}, {"any": [{"campo": "invasion_linfovascular", "eq": true}, {"campo": "candidato_vigilancia", "eq": false}]}], "componentes": ["quimioterapia"], "evidencia": "I, A"},
  {"id": "seminoma_II_rt_chemo", "label": "Seminoma II bajo volumen: RT o quimioterapia", "nota": "ESMO seminoma estadio IIA/IIB bajo volumen: radioterapia para IIA/IIB seleccionados o quimioterapia basada en cisplatino segun volumen.", "cuando": [{"campo": "histologia_tg", "eq": "seminoma"}, {"campo": "estadio_tg", "eq": "II"}, {"campo": "riesgo_igcccg", "eq": "bueno"}], "componentes": ["radioterapia", "quimioterapia"], "evidencia": "I, A"},
  {"id": "bep3_buen_riesgo", "label": "BEP x3", "nota": "ESMO tumor germinal metastasico IGCCCG buen riesgo: BEP x3 es estandar; EP x4 si bleomicina contraindicada.", "cuando": [{"campo": "estadio_tg", "in": ["II", "III"]}, {"campo": "riesgo_igcccg", "eq": "bueno"}, {"any": [{"campo": "candidato_bleomicina", "missing": true}, {"campo": "candidato_bleomicina", "eq": true}]}], "componentes": ["quimioterapia"], "evidencia": "I, A"},
  {"id": "ep4_buen_riesgo", "label": "EP x4", "nota": "ESMO buen riesgo con contraindicacion a bleomicina: etoposido-cisplatino x4 es alternativa estandar a BEP x3.", "cuando": [{"campo": "estadio_tg", "in": ["II", "III"]}, {"campo": "riesgo_igcccg", "eq": "bueno"}, {"campo": "candidato_bleomicina", "eq": false}], "componentes": ["quimioterapia"], "evidencia": "I, A"},
  {"id": "bep4_inter_pobre", "label": "BEP x4", "nota": "ESMO IGCCCG intermedio o pobre: BEP x4 es estandar curativo si candidato a bleomicina.", "cuando": [{"campo": "estadio_tg", "in": ["II", "III"]}, {"campo": "riesgo_igcccg", "in": ["intermedio", "pobre"]}, {"any": [{"campo": "candidato_bleomicina", "missing": true}, {"campo": "candidato_bleomicina", "eq": true}]}], "componentes": ["quimioterapia"], "evidencia": "I, A"},
  {"id": "vip4_inter_pobre", "label": "VIP x4", "nota": "ESMO intermedio/pobre con contraindicacion a bleomicina: VIP x4 es alternativa a BEP x4.", "cuando": [{"campo": "estadio_tg", "in": ["II", "III"]}, {"campo": "riesgo_igcccg", "in": ["intermedio", "pobre"]}, {"campo": "candidato_bleomicina", "eq": false}], "componentes": ["quimioterapia"], "evidencia": "I, B"},
  {"id": "reseccion_masa_residual_nsgct", "label": "Reseccion de masa residual postquimioterapia", "nota": "ESMO NSGCT: masa residual >1 cm con marcadores normalizados tras quimioterapia -> reseccion quirurgica especializada.", "cuando": [{"campo": "histologia_tg", "in": ["no_seminoma", "mixto"]}, {"campo": "estadio_tg", "eq": "masa_residual"}, {"campo": "masa_residual_cm", "gt": 1}, {"campo": "marcadores_normalizados", "eq": true}], "componentes": ["cirugia"], "evidencia": "I, A"},
  {"id": "observacion_masa_residual_seminoma", "label": "Observacion/PET en seminoma residual", "nota": "ESMO seminoma: masa residual postquimioterapia se observa; PET-FDG si >3 cm para guiar manejo, no reseccion rutinaria.", "cuando": [{"campo": "histologia_tg", "eq": "seminoma"}, {"campo": "estadio_tg", "eq": "masa_residual"}], "componentes": ["vigilancia"], "evidencia": "II, B"},
  {"id": "rescate_tip_altadosis", "label": "Quimioterapia de rescate TIP o altas dosis + rescate hematopoyetico", "nota": "ESMO recaida tras cisplatino: TIP/VeIP o quimioterapia de altas dosis en centros expertos segun riesgo y respuesta previa.", "cuando": {"campo": "estadio_tg", "eq": "recaida"}, "componentes": ["quimioterapia", "trasplante"], "evidencia": "I, B"}
 ],
