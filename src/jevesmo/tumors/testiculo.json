  {"id": "estadio_tg", "label": "Estadio", "tipo": "choice", "opciones": ["I", "II", "III", "masa_residual", "recaida"], "requerido": true, "pregunta": "¿Cual es el estadio/entorno (I, II, III, masa residual o recaida)?"},
  {"id": "riesgo_igcccg", "label": "Riesgo IGCCCG", "tipo": "choice", "opciones": ["bueno", "intermedio", "pobre"], "requerido_si": {"campo": "estadio_tg", "in": ["II", "III"]}, "pregunta": "En enfermedad metastasica/avanzada, ¿cual es el riesgo IGCCCG?"},
  {"id": "marcadores_normalizados", "label": "Marcadores tumorales normalizados", "tipo": "bool", "seccion": "Biomarcadores"},
