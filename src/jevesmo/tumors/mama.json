 "preguntas": [
  {
   "key": "her2_equivoco",
   "tipo": "noul",
   "capa": 1,
   "cuando": {
    "campo": "her2_ihc_score",
    "eq": "2+"
   },
   "instrucciones": "El IHC de HER2 es equivoco (2+). Basandote en el contexto clínico disponible, ¿es clinicamente prudente tratar este caso como HER2 positivo en ausencia de confirmación FISH?"
  },
  {
   "key": "ki67_riesgo",
   "tipo": "choice",
   "capa": 1,
   "cuando": [
    {
     "campo": "ki67_porcentaje",
     "gte": 14
    },
    {
     "campo": "ki67_porcentaje",
     "lte": 25
    }
   ],
   "instrucciones": "Con Ki67 en zona intermedia, clasifica el riesgo proliferativo del tumor",
   "criterios": {
    "bajo_riesgo": "Proliferación baja, comportamiento más indolente",
    "alto_riesgo": "Proliferación alta, considerar tratamiento más agresivo"
   }
  },
  {
   "key": "sospecha_brca",
   "tipo": "noul",
   "capa": 2,
   "cuando": {
    "campo": "brca_mutado",
    "missing": true
   },
   "instrucciones": "No hay test BRCA disponible. Según edad, subtipo tumoral e historia clínica, ¿existe sospecha clínica suficiente de mutación BRCA1/2 como para recomendar test germinal antes de decidir tratamiento?"
  },
  {
   "key": "pdl1_limitrofe",
   "tipo": "score",
   "capa": 2,
   "cuando": [
    {
     "campo": "pdl1_cps",
     "gte": 5
    },
    {
     "campo": "pdl1_cps",
     "lt": 10
    }
   ],
   "instrucciones": "PD-L1 CPS limitrofe (5-10). Evalúa la probabilidad de beneficio real de inmunoterapia",
   "criterios": [
    "Beneficio improbable",
    "Beneficio incierto",
    "Beneficio probable"
   ]
  }
 ],
