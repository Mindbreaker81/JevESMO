 "derivados": [
  {
   "id": "subtipo",
   "label": "Subtipo molecular",
   "defecto": "TNBC",
   "reglas": [
    {
     "cuando": [
      {
       "campo": "her2",
       "eq": "positivo"
      },
      {
       "any": [
        {
         "campo": "re",
         "eq": "positivo"
        },
        {
         "campo": "rp",
         "eq": "positivo"
        }
       ]
      }
     ],
     "valor": "HR+/HER2+"
    },
    {
     "cuando": {
      "campo": "her2",
      "eq": "positivo"
     },
     "valor": "HER2+"
    },
    {
     "cuando": {
      "any": [
       {
        "campo": "re",
        "eq": "positivo"
       },
       {
        "campo": "rp",
        "eq": "positivo"
       }
      ]
     },
     "valor": "HR+/HER2-"
    }
   ]
  }
 ],
