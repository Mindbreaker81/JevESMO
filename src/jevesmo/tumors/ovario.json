{
 "id": "ovario",
 "nombre": "Cancer epitelial de ovario",
 "grupo": "Ginecologico",
 "version": "OVARIO-ESMO-2025.1",
 "guias": [
  {
   "titulo": "ESMO Clinical Practice Guideline / Living Guideline: Epithelial ovarian cancer",
   "anio": 2025,
   "url": "https://www.esmo.org/guidelines/gynaecological-cancers/ovarian-cancer"
  },
  {
   "titulo": "ESGO-ESMO-ESP consensus recommendations on ovarian cancer",
   "anio": 2024,
   "url": "https://www.esmo.org/guidelines/gynaecological-cancers"
  }
 ],
 "descripcion": "Cancer epitelial de ovario: histologia, estadio, cirugia primaria o neoadyuvancia, platino-taxano +- bevacizumab, mantenimiento PARP por BRCA/HRD y recaida.",
 "campos": [
  {
   "id": "estadio",
   "label": "Estadio FIGO",
   "tipo": "choice",
   "opciones": [
    "I",
    "II",
    "III",
    "IV",
    "recaida"
   ],
   "requerido": true,
   "pregunta": "¿Cual es el estadio FIGO o si se trata de recaida?"
  },
  {
   "id": "histologia",
   "label": "Histologia",
   "tipo": "choice",
   "opciones": [
    "seroso_alto_grado",
    "endometrioide_alto_grado",
    "mucinoso",
    "celulas_claras",
    "bajo_grado",
    "otro_epitelial"
   ],
   "requerido": true,
   "pregunta": "¿Cual es la histologia epitelial principal?"
  },
  {
   "id": "grado",
   "label": "Grado",
   "tipo": "choice",
   "opciones": [
    "1",
    "2",
    "3"
   ]
  },
  {
   "id": "cirugia_primaria_factible",
   "label": "Citorreduccion primaria completa factible",
   "tipo": "bool",
   "requerido_si": {
    "campo": "estadio",
    "in": [
     "III",
     "IV"
    ]
   },
   "pregunta": "En estadio III-IV, ¿es factible citorreduccion primaria completa por equipo experto?"
  },
  {
   "id": "enfermedad_residual",
   "label": "Enfermedad residual tras cirugia",
   "tipo": "choice",
   "opciones": [
    "R0",
    "macroscopica",
    "no_operada"
   ]
  },
  {
   "id": "brca",
   "label": "BRCA1/2",
   "tipo": "choice",
   "opciones": [
    "mutado",
    "no_mutado",
    "desconocido"
   ],
   "requerido_si": {
    "campo": "estadio",
    "in": [
     "III",
     "IV",
     "recaida"
    ]
   },
   "pregunta": "¿Cual es el estado BRCA1/2?"
  },
  {
   "id": "hrd",
   "label": "HRD",
   "tipo": "choice",
   "opciones": [
    "positivo",
    "negativo",
    "desconocido"
   ]
  },
  {
   "id": "bevacizumab_usado_1l",
   "label": "Bevacizumab usado en 1L",
   "tipo": "bool"
  },
  {
   "id": "intervalo_platino_meses",
   "label": "Intervalo libre de platino",
   "tipo": "number",
   "min": 0,
   "max": 120,
   "unidad": "meses",
   "requerido_si": {
    "campo": "estadio",
    "eq": "recaida"
   },
   "pregunta": "En recaida, ¿cual es el intervalo libre de platino en meses?"
  },
  {
   "id": "fralfa",
   "label": "FRalfa",
   "tipo": "choice",
   "opciones": [
    "alto",
    "bajo",
    "desconocido"
   ]
  },
  {
   "id": "contra_bev",
   "label": "Contraindicacion para bevacizumab",
   "tipo": "bool"
  }
 ],
 "derivados": [
  {
   "id": "platino_sensible",
   "label": "Sensibilidad a platino",
   "defecto": "no_aplica",
   "reglas": [
    {
     "cuando": [
      {
       "campo": "estadio",
       "eq": "recaida"
      },
      {
       "campo": "intervalo_platino_meses",
       "gte": 6
      }
     ],
     "valor": "sensible"
    },
    {
     "cuando": [
      {
       "campo": "estadio",
       "eq": "recaida"
      },
      {
       "campo": "intervalo_platino_meses",
       "lt": 6
      }
     ],
     "valor": "resistente"
    }
   ]
  }
 ],
 "opciones": [
  {
   "id": "cirugia_estadiaje_precoz",
   "label": "Cirugia de estadiaje completa y vigilancia",
   "nota": "ESMO: estadio I bajo riesgo completamente estadificado (bajo grado IA/IB) puede observarse tras cirugia adecuada.",
   "cuando": [
    {
     "campo": "estadio",
     "eq": "I"
    },
    {
     "campo": "histologia",
     "in": [
      "bajo_grado",
      "mucinoso"
     ]
    },
    {
     "campo": "grado",
     "in": [
      "1",
      "2"
     ]
    }
   ],
   "componentes": [
    "cirugia",
    "vigilancia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "quimio_adyuvante_precoz",
   "label": "Carboplatino-paclitaxel adyuvante",
   "nota": "ESMO: estadio I-II de alto riesgo (alto grado, celulas claras, IC-II o estadiaje incompleto) requiere quimioterapia adyuvante con platino-taxano.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "I",
      "II"
     ]
    },
    {
     "any": [
      {
       "campo": "estadio",
       "eq": "II"
      },
      {
       "campo": "histologia",
       "in": [
        "seroso_alto_grado",
        "endometrioide_alto_grado",
        "celulas_claras"
       ]
      },
      {
       "campo": "grado",
       "eq": "3"
      }
     ]
    }
   ],
   "componentes": [
    "quimioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "debulking_primario_qt",
   "label": "Citorreduccion primaria completa seguida de carboplatino-paclitaxel",
   "nota": "ESMO: estadio III-IV con posibilidad de reseccion completa -> cirugia primaria seguida de carboplatino-paclitaxel.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "III",
      "IV"
     ]
    },
    {
     "campo": "cirugia_primaria_factible",
     "eq": true
    }
   ],
   "componentes": [
    "cirugia",
    "quimioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "neoadyuvancia_ids",
   "label": "Carboplatino-paclitaxel neoadyuvante + cirugia de intervalo",
   "nota": "ESMO: estadio III-IV no resecable de entrada -> neoadyuvancia y cirugia de intervalo si respuesta.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "III",
      "IV"
     ]
    },
    {
     "campo": "cirugia_primaria_factible",
     "eq": false
    }
   ],
   "componentes": [
    "quimioterapia",
    "cirugia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "qt_bev_1l",
   "label": "Carboplatino-paclitaxel + bevacizumab y mantenimiento",
   "nota": "ESMO: estadio III con residual macroscopica o estadio IV puede recibir bevacizumab con QT y mantenimiento si no contraindicado.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "III",
      "IV"
     ]
    },
    {
     "campo": "contra_bev",
     "ne": true
    },
    {
     "any": [
      {
       "campo": "enfermedad_residual",
       "eq": "macroscopica"
      },
      {
       "campo": "estadio",
       "eq": "IV"
      }
     ]
    }
   ],
   "componentes": [
    "quimioterapia",
    "antiangiogenico"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "mantenimiento_olaparib",
   "label": "Mantenimiento olaparib",
   "nota": "SOLO-1/ESMO: respuesta a platino en primera linea, cancer alto grado avanzado BRCA mutado -> olaparib mantenimiento.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "III",
      "IV"
     ]
    },
    {
     "campo": "brca",
     "eq": "mutado"
    }
   ],
   "componentes": [
    "dirigida"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "mantenimiento_olaparib_bev",
   "label": "Mantenimiento olaparib + bevacizumab",
   "nota": "PAOLA-1/ESMO: si se uso bevacizumab en 1L y HRD positivo (incluye BRCA) -> olaparib + bevacizumab.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "III",
      "IV"
     ]
    },
    {
     "campo": "bevacizumab_usado_1l",
     "eq": true
    },
    {
     "any": [
      {
       "campo": "hrd",
       "eq": "positivo"
      },
      {
       "campo": "brca",
       "eq": "mutado"
      }
     ]
    }
   ],
   "componentes": [
    "dirigida",
    "antiangiogenico"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "mantenimiento_niraparib",
   "label": "Mantenimiento niraparib",
   "nota": "PRIMA/ESMO: tras respuesta a platino en enfermedad avanzada sin BRCA mutado, niraparib es opcion de mantenimiento, mayor beneficio si HRD positivo.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "III",
      "IV"
     ]
    },
    {
     "campo": "brca",
     "ne": "mutado"
    }
   ],
   "componentes": [
    "dirigida"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "recaida_platino_sensible",
   "label": "Doblete basado en platino +- bevacizumab/PARP",
   "nota": "ESMO: recaida platino-sensible (intervalo >=6 meses) -> combinacion basada en platino; considerar bevacizumab o mantenimiento PARP segun antecedentes.",
   "cuando": {
    "campo": "platino_sensible",
    "eq": "sensible"
   },
   "componentes": [
    "quimioterapia",
    "antiangiogenico",
    "dirigida"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "recaida_platino_resistente",
   "label": "Quimioterapia no platino secuencial +- bevacizumab",
   "nota": "AURELIA/ESMO: recaida resistente a platino -> agente unico no platino; bevacizumab si no contraindicado.",
   "cuando": [
    {
     "campo": "platino_sensible",
     "eq": "resistente"
    },
    {
     "campo": "fralfa",
     "ne": "alto"
    }
   ],
   "componentes": [
    "quimioterapia",
    "antiangiogenico"
   ],
   "evidencia": "I, B"
  },
  {
   "id": "mirvetuximab_fralfa",
   "label": "Mirvetuximab soravtansina",
   "nota": "MIRASOL/ESMO: enfermedad resistente a platino, FRalfa alto y lineas previas -> mirvetuximab preferente frente a quimioterapia.",
   "cuando": [
    {
     "campo": "platino_sensible",
     "eq": "resistente"
    },
    {
     "campo": "fralfa",
     "eq": "alto"
    },
    {
     "campo": "lineas_previas",
     "gte": 1
    }
   ],
   "componentes": [
    "dirigida"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "soporte_ensayo",
   "label": "Mejor soporte/ensayo clinico",
   "nota": "ESMO: ECOG pobre o situacion fuera de estandar -> soporte, control sintomatico y/o ensayo clinico.",
   "cuando": {
    "campo": "ecog",
    "in": [
     "3",
     "4"
    ]
   },
   "componentes": [
    "soporte"
   ],
   "evidencia": "V, A"
  }
 ],
