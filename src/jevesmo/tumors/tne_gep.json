    {
     "campo": "categoria",
     "eq": "NET_G1_G2"
    },
    {
     "campo": "setting",
     "eq": "avanzado_estable_bajo_volumen"
    },
    {
     "campo": "funcionante",
     "eq": false
    }
   ],
   "componentes": [
    "vigilancia"
   ],
   "evidencia": "III, B"
  }
 ],
