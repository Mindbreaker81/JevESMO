   "url": "https://www.esmo.org/guidelines/gastrointestinal-cancers/neuroendocrine-tumours"
  }
 ],
 "descripcion": "NET G1/G2/G3 y NEC GEP: SSTR, analogos somatostatina, PRRT Lu-177, everolimus, sunitinib pancreático, CAPTEM y platino-etoposido.",
 "campos": [
  {
   "id": "categoria",
   "label": "Categoría",
   "tipo": "choice",
   "seccion": "Tumor",
   "opciones": [
    "NET_G1_G2",
    "NET_G3_bien_dif",
    "NEC_pobre_dif"
   ],
   "requerido": true,
   "pregunta": "¿Es NET G1/G2, NET G3 bien diferenciado o NEC pobremente diferenciado?"
  },
  {
   "id": "origen",
   "label": "Origen",
   "tipo": "choice",
   "seccion": "Tumor",
   "opciones": [
    "pancreatico",
    "intestino_medio",
    "rectal",
    "gastrico_duodenal",
    "desconocido"
   ],
   "requerido": true,
   "pregunta": "¿Cuál es el origen primario GEP?"
  },
  {
   "id": "setting",
   "label": "Setting",
   "tipo": "choice",
   "seccion": "Tumor",
   "opciones": [
    "localizado_resecable",
    "avanzado_estable_bajo_volumen",
    "avanzado_progresivo",
    "crisis_funcional"
   ],
   "requerido": true,
   "pregunta": "¿Es localizado resecable, avanzado estable bajo volumen, avanzado progresivo o crisis funcional?"
  },
  {
   "id": "sstr",
   "label": "SSTR positivo en imagen",
   "tipo": "choice",
   "seccion": "Biomarcadores",
   "opciones": [
    "positivo",
    "negativo",
    "desconocido"
   ],
   "requerido": true,
   "pregunta": "¿La imagen funcional SSTR es positiva?"
  },
  {
   "id": "ki67",
   "label": "Ki-67",
   "tipo": "number",
   "seccion": "Anatomía patológica",
   "min": 0,
   "max": 100,
   "unidad": "%"
  },
  {
   "id": "funcionante",
   "label": "Sindrómico/funcionante",
   "tipo": "bool",
   "seccion": "Tumor"
  },
  {
   "id": "volumen_tumoral_alto",
   "label": "Volumen tumoral alto o progresión rápida",
   "tipo": "bool",
   "seccion": "Tumor"
  },
  {
   "id": "funcion_renal_prrt_apta",
   "label": "Función renal/medular apta para PRRT",
   "tipo": "bool",
   "seccion": "Seguridad"
  },
  {
   "id": "diabetes_mal_controlada",
   "label": "Diabetes mal controlada",
   "tipo": "bool",
   "seccion": "Seguridad"
  }
 ],
 "opciones": [
  {
   "id": "cirugia_net_localizado",
   "label": "Resección quirúrgica del NET localizado",
   "nota": "ESMO: NET GEP localizado resecable -> cirugía con intención curativa y linfadenectomía según localización.",
   "cuando": [
    {
     "campo": "setting",
     "eq": "localizado_resecable"
    },
    {
     "campo": "categoria",
     "in": [
      "NET_G1_G2",
      "NET_G3_bien_dif"
     ]
    }
   ],
   "componentes": [
    "cirugia"
   ],
   "evidencia": "III, A"
  },
  {
   "id": "cirugia_nec_localizado",
   "label": "Cirugía + quimioterapia perioperatoria en NEC localizado",
   "nota": "ESMO: NEC GEP localizado resecable -> tratamiento multimodal con platino-etoposido perioperatorio y cirugía seleccionada.",
   "cuando": [
    {
     "campo": "setting",
     "eq": "localizado_resecable"
    },
    {
     "campo": "categoria",
     "eq": "NEC_pobre_dif"
    }
   ],
   "componentes": [
    "cirugia",
    "quimioterapia"
   ],
   "evidencia": "IV, B"
  },
  {
   "id": "ssa_control",
   "label": "Analogo de somatostatina",
   "nota": "ESMO/PROMID-CLARINET: NET G1/G2 SSTR+ avanzado, funcionante o bajo volumen -> octreotida/lanreotida.",
   "cuando": [
    {
     "campo": "categoria",
     "eq": "NET_G1_G2"
    },
    {
     "campo": "sstr",
     "eq": "positivo"
    },
    {
     "campo": "setting",
     "in": [
      "avanzado_estable_bajo_volumen",
      "crisis_funcional"
     ]
    }
   ],
   "componentes": [
    "dirigida"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "prrt_lu177",
   "label": "PRRT Lu-177 DOTATATE",
   "nota": "ESMO/NETTER-1/2: NET SSTR+ progresivo tras SSA o necesidad de control -> Lu-177 DOTATATE si renal/medular apto.",
   "cuando": [
    {
     "campo": "sstr",
     "eq": "positivo"
    },
    {
     "campo": "setting",
     "eq": "avanzado_progresivo"
    },
    {
     "campo": "categoria",
     "in": [
      "NET_G1_G2",
      "NET_G3_bien_dif"
     ]
    }
   ],
   "componentes": [
    "radionuclido"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "everolimus_net",
   "label": "Everolimus",
   "nota": "ESMO: NET pancreático o gastrointestinal no funcionante progresivo -> everolimus.",
   "cuando": {
    "all": [
     {
      "campo": "categoria",
      "in": [
       "NET_G1_G2",
       "NET_G3_bien_dif"
      ]
     },
     {
      "campo": "setting",
      "eq": "avanzado_progresivo"
     },
     {
      "not": {
       "all": [
        {
         "campo": "origen",
         "eq": "intestino_medio"
        },
        {
         "campo": "sstr",
         "eq": "positivo"
        }
       ]
      }
     }
    ]
   },
   "componentes": [
    "dirigida"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "sunitinib_pnet",
   "label": "Sunitinib en NET pancreático",
   "nota": "ESMO: NET pancreático progresivo bien diferenciado -> sunitinib.",
   "cuando": [
    {
     "campo": "origen",
     "eq": "pancreatico"
    },
    {
     "campo": "categoria",
     "eq": "NET_G1_G2"
    },
    {
     "campo": "setting",
     "eq": "avanzado_progresivo"
    }
   ],
   "componentes": [
    "dirigida",
    "antiangiogenico"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "captem_pnet",
   "label": "CAPTEM/quimioterapia temozolomida",
   "nota": "ESMO: NET pancreático o NET G3 bien diferenciado con Ki-67 alto/volumen alto -> capecitabina-temozolomida.",
   "cuando": [
    {
     "campo": "categoria",
     "in": [
      "NET_G1_G2",
      "NET_G3_bien_dif"
     ]
    },
    {
     "campo": "setting",
     "eq": "avanzado_progresivo"
    },
    {
     "any": [
      {
       "campo": "origen",
       "eq": "pancreatico"
      },
      {
       "campo": "volumen_tumoral_alto",
       "eq": true
      },
      {
       "campo": "ki67",
       "gte": 10
      }
     ]
    }
   ],
   "componentes": [
    "quimioterapia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "platino_etoposido_nec",
   "label": "Platino + etoposido",
   "nota": "ESMO: NEC GEP pobremente diferenciado avanzado -> cis/carboplatino + etoposido 1L.",
   "cuando": [
    {
     "campo": "categoria",
     "eq": "NEC_pobre_dif"
    },
    {
     "campo": "setting",
     "in": [
      "avanzado_progresivo",
      "crisis_funcional"
     ]
    },
    {
     "any": [
      {
       "campo": "lineas_previas",
       "missing": true
      },
      {
       "campo": "lineas_previas",
       "eq": 0
      }
     ]
    }
   ],
   "componentes": [
    "quimioterapia"
   ],
   "evidencia": "III, A"
  },
  {
   "id": "folfox_folfiri_nec_2l",
   "label": "FOLFOX/FOLFIRI 2L NEC",
   "nota": "ESMO: NEC progresivo tras platino -> FOLFOX/FOLFIRI o ensayo clínico.",
   "cuando": [
    {
     "campo": "categoria",
     "eq": "NEC_pobre_dif"
    },
    {
     "campo": "lineas_previas",
     "gte": 1
    }
   ],
   "componentes": [
    "quimioterapia"
   ],
   "evidencia": "IV, B"
  },
  {
   "id": "vigilancia_net_bajo_volumen",
   "label": "Vigilancia activa estrecha",
   "nota": "ESMO: NET G1/G2 no funcionante, bajo volumen y estable puede observarse con seguimiento estrecho.",
