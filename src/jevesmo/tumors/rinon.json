  {
   "id": "nefrectomia_vigilancia",
   "label": "Nefrectomía parcial/radical y vigilancia",
   "nota": "ESMO RCC localizado: cirugía con preservación renal si posible y vigilancia según riesgo es estándar para enfermedad resecable de riesgo bajo/intermedio.",
   "cuando": [
    {
     "campo": "estadio_rinon",
     "eq": "localizado"
    },
    {
     "any": [
      {
       "campo": "alto_riesgo_recaida",
       "eq": false
      },
      {
       "campo": "alto_riesgo_recaida",
       "missing": true
      }
