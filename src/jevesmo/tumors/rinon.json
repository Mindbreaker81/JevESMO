{
 "id": "rinon",
 "nombre": "Carcinoma renal",
 "grupo": "Genitourinario",
 "version": "RINON-ESMO-2024.1",
 "guias": [
  {
   "titulo": "Renal cell carcinoma: ESMO Clinical Practice Guideline for diagnosis, treatment and follow-up",
   "anio": 2024,
   "url": "https://www.esmo.org/guidelines/genitourinary-cancers/renal-cell-carcinoma"
  }
 ],
 "descripcion": "Carcinoma renal localizado y avanzado por histología, riesgo IMDC y línea, incluyendo pembrolizumab adyuvante, ICI+TKI, nivolumab+ipilimumab, cabozantinib y belzutifan.",
 "campos": [
  {
   "id": "estadio_rinon",
   "label": "Estadio/entorno",
   "tipo": "choice",
   "opciones": [
    "localizado",
    "avanzado"
   ],
   "requerido": true,
   "pregunta": "¿El carcinoma renal es localizado o avanzado/metastasico?"
  },
  {
   "id": "histologia_rinon",
   "label": "Histología",
   "tipo": "choice",
   "opciones": [
    "celulas_claras",
    "papilar",
    "cromofobo",
    "no_claras_otro"
   ],
   "requerido": true,
   "pregunta": "¿Cuál es la histología (células claras, papilar, cromofobo/no claras)?"
  },
  {
   "id": "riesgo_imdc",
   "label": "Riesgo IMDC",
   "tipo": "choice",
   "opciones": [
    "favorable",
    "intermedio",
    "pobre"
   ],
   "requerido_si": {
    "campo": "estadio_rinon",
    "eq": "avanzado"
   },
   "pregunta": "En enfermedad avanzada, ¿cuál es el riesgo IMDC?"
  },
  {
   "id": "alto_riesgo_recaida",
   "label": "Alto riesgo de recaída post-nefrectomia",
   "tipo": "bool",
   "seccion": "Adyuvancia"
  },
  {
   "id": "nefrectomia_realizada",
   "label": "Nefrectomía realizada",
   "tipo": "bool",
   "seccion": "Tratamiento local"
  },
  {
   "id": "necesidad_respuesta_rapida",
   "label": "Necesidad de respuesta rápida/alta carga",
   "tipo": "bool",
   "seccion": "Enfermedad avanzada"
  },
  {
   "id": "candidato_ici",
   "label": "Candidato a inmunoterapia",
   "tipo": "bool",
   "seccion": "Tratamiento sistémico"
  },
  {
   "id": "candidato_tki",
   "label": "Candidato a antiangiogénico/TKI",
   "tipo": "bool",
   "seccion": "Tratamiento sistémico"
