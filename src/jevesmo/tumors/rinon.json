  {
   "id": "nefrectomia_vigilancia",
   "label": "Nefrectomia parcial/radical y vigilancia",
   "nota": "ESMO RCC localizado: cirugia con preservacion renal si posible y vigilancia segun riesgo es estandar para enfermedad resecable de riesgo bajo/intermedio.",
   "cuando": [
    {
     "campo": "estadio_rinon",
     "eq": "localizado"
    },
    {
     "any": [
      {
       "campo": "alto_riesgo_recaida",
       "eq": false
      },
      {
       "campo": "alto_riesgo_recaida",
       "missing": true
      }
     ]
    }
   ],
   "componentes": [
    "cirugia",
    "vigilancia"
   ],
   "evidencia": "I, A"
  },
