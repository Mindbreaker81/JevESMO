{
 "id": "rinon",
 "nombre": "Carcinoma renal",
 "grupo": "Genitourinario",
 "version": "RINON-ESMO-2024.1",
 "guias": [
  {
   "titulo": "Renal cell carcinoma: ESMO Clinical Practice Guideline for diagnosis, treatment and follow-up",
   "anio": 2024,
   "url": "https://www.esmo.org/guidelines/genitourinary-cancers/renal-cell-carcinoma"
  }
 ],
 "descripcion": "Carcinoma renal localizado y avanzado por histologia, riesgo IMDC y linea, incluyendo pembrolizumab adyuvante, ICI+TKI, nivolumab+ipilimumab, cabozantinib y belzutifan.",
 "campos": [
  {
   "id": "estadio_rinon",
   "label": "Estadio/entorno",
   "tipo": "choice",
   "opciones": [
    "localizado",
    "avanzado"
   ],
   "requerido": true,
   "pregunta": "¿El carcinoma renal es localizado o avanzado/metastasico?"
  },
  {
   "id": "histologia_rinon",
   "label": "Histologia",
   "tipo": "choice",
   "opciones": [
    "celulas_claras",
    "papilar",
    "cromofobo",
    "no_claras_otro"
   ],
   "requerido": true,
   "pregunta": "¿Cual es la histologia (celulas claras, papilar, cromofobo/no claras)?"
  },
  {
   "id": "riesgo_imdc",
   "label": "Riesgo IMDC",
   "tipo": "choice",
   "opciones": [
    "favorable",
    "intermedio",
    "pobre"
   ],
   "requerido_si": {
    "campo": "estadio_rinon",
    "eq": "avanzado"
   },
   "pregunta": "En enfermedad avanzada, ¿cual es el riesgo IMDC?"
  },
  {
   "id": "alto_riesgo_recaida",
   "label": "Alto riesgo de recaida post-nefrectomia",
   "tipo": "bool",
   "seccion": "Adyuvancia"
  },
  {
   "id": "nefrectomia_realizada",
   "label": "Nefrectomia realizada",
   "tipo": "bool",
   "seccion": "Tratamiento local"
  },
  {
   "id": "necesidad_respuesta_rapida",
   "label": "Necesidad de respuesta rapida/alta carga",
   "tipo": "bool",
   "seccion": "Enfermedad avanzada"
  },
  {
   "id": "candidato_ici",
   "label": "Candidato a inmunoterapia",
   "tipo": "bool",
   "seccion": "Tratamiento sistemico"
  },
  {
   "id": "candidato_tki",
   "label": "Candidato a antiangiogenico/TKI",
   "tipo": "bool",
   "seccion": "Tratamiento sistemico"
  },
  {
   "id": "vhl_alterado",
   "label": "Alteracion VHL o indicacion belzutifan",
   "tipo": "bool",
   "seccion": "Biomarcadores"
  }
 ],
