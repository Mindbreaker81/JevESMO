 "grupo": "Piel",
 "version": "CARCINOMA_BASOCELULAR-ESMO-2024.1",
 "guias": [
  {
   "titulo": "ESMO Clinical Practice Guidelines: Melanoma and Skin Cancers",
   "anio": 2024,
   "url": "https://www.esmo.org/guidelines/melanoma-and-skin-cancers"
  }
 ],
 "descripcion": "Carcinoma basocelular: cirugía/Mohs/RT, inhibidores Hedgehog y cemiplimab tras progresión/intolerancia.",
 "campos": [
  {
   "id": "situacion",
   "label": "Situación",
   "tipo": "choice",
   "seccion": "Tumor",
   "opciones": [
    "localizado_bajo_riesgo",
    "localizado_alto_riesgo",
    "localmente_avanzado",
    "metastasico"
   ],
   "requerido": true,
   "pregunta": "¿Cuál es la situación del carcinoma basocelular?"
  },
  {
   "id": "resecable",
   "label": "Resecable",
   "tipo": "bool",
   "seccion": "Cirugía"
  },
  {
   "id": "hhi_previo",
   "label": "Inhibidor Hedgehog previo",
   "tipo": "bool",
   "seccion": "Historial"
  },
  {
   "id": "hhi_apto",
   "label": "Apto para inhibidor Hedgehog",
   "tipo": "bool",
   "seccion": "Seguridad"
  },
  {
   "id": "candidato_ici",
   "label": "Candidato a cemiplimab",
   "tipo": "bool",
   "seccion": "Seguridad"
  }
 ],
 "derivados": [],
 "opciones": [
  {
   "id": "escision_bcc",
   "label": "Escisión quirúrgica estándar",
   "nota": "BCC localizado de bajo riesgo: escisión completa con margenes adecuados.",
   "cuando": {
    "campo": "situacion",
    "eq": "localizado_bajo_riesgo"
   },
   "componentes": [
    "cirugia"
   ],
   "evidencia": "III, A"
  },
  {
   "id": "mohs_bcc_alto_riesgo",
   "label": "Cirugía micrográfica de Mohs",
   "nota": "BCC alto riesgo, recurrente o zona H facial: Mohs/control micrográfico de margenes.",
   "cuando": {
    "campo": "situacion",
    "eq": "localizado_alto_riesgo"
   },
   "componentes": [
    "cirugia"
   ],
   "evidencia": "III, A"
  },
  {
   "id": "rt_bcc_no_cirugia",
   "label": "Radioterapia definitiva",
   "nota": "BCC localizado no candidato a cirugía o cirugía muy morbida: RT definitiva.",
   "cuando": [
    {
     "campo": "situacion",
     "in": [
      "localizado_bajo_riesgo",
      "localizado_alto_riesgo"
     ]
    },
    {
     "campo": "resecable",
     "eq": false
    }
   ],
   "componentes": [
    "radioterapia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "vismo_soni_bcc",
   "label": "Vismodegib o sonidegib",
   "nota": "BCC localmente avanzado/metastasico no candidato a cirugía/RT curativa: inhibidor Hedgehog.",
   "cuando": [
    {
     "campo": "situacion",
     "in": [
      "localmente_avanzado",
      "metastasico"
     ]
    },
    {
     "not": {
      "campo": "hhi_previo",
      "eq": true
     }
    },
    {
     "not": {
      "campo": "hhi_apto",
      "eq": false
     }
    }
   ],
   "componentes": [
    "dirigida"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "cemiplimab_bcc_2l",
   "label": "Cemiplimab tras HHI",
   "nota": "BCC avanzado que progresa o no tolera inhibidor Hedgehog: cemiplimab 2L.",
   "cuando": [
    {
     "campo": "situacion",
     "in": [
      "localmente_avanzado",
      "metastasico"
     ]
    },
    {
     "campo": "hhi_previo",
     "eq": true
    },
    {
     "not": {
      "campo": "candidato_ici",
      "eq": false
     }
    }
   ],
   "componentes": [
    "inmunoterapia"
   ],
   "evidencia": "II, A"
  },
  {
   "id": "rt_paliativa_bcc",
   "label": "Radioterapia/cirugia paliativa local",
   "nota": "Si enfermedad local sintomática y no candidato a sistémico, considerar RT/cirugia paliativa.",
   "cuando": [
    {
     "campo": "situacion",
     "in": [
      "localmente_avanzado",
      "metastasico"
     ]
    },
    {
     "campo": "hhi_apto",
     "eq": false
    },
    {
     "campo": "candidato_ici",
     "eq": false
    }
   ],
   "componentes": [
    "radioterapia",
    "soporte"
   ],
   "evidencia": "IV, B"
  },
  {
   "id": "soporte_bcc",
   "label": "Soporte exclusivo",
   "nota": "Enfermedad muy fragil/ECOG 3-4: soporte y control sintomático.",
   "cuando": {
    "campo": "ecog",
    "in": [
     "3",
     "4"
    ]
   },
   "componentes": [
    "soporte"
   ],
   "evidencia": "V, A"
  }
 ],
 "preguntas": [
  {
   "key": "morbilidad_cirugia_bcc",
   "tipo": "noul",
   "capa": 1,
   "cuando": {
    "campo": "situacion",
    "in": [
     "localizado_alto_riesgo",
     "localmente_avanzado"
    ]
   },
   "instrucciones": "¿La cirugía produciria morbilidad funcional/cosmetica desproporcionada?"
  },
  {
   "key": "respuesta_hhi_bcc",
   "tipo": "score",
   "capa": 2,
   "cuando": {
    "campo": "situacion",
    "in": [
     "localmente_avanzado",
     "metastasico"
    ]
   },
   "instrucciones": "Estima la probabilidad de beneficio neto con inhibidor Hedgehog.",
   "criterios": [
    "Baja",
    "Intermedia",
    "Alta"
   ]
  }
 ],
 "seguridad": [
  {
   "key": "contra_ici_bcc",
   "cuando": {
    "campo": "comorbilidades_relevantes",
    "present": true
   },
   "bloquea_componentes": [
    "inmunoterapia"
   ],
   "instrucciones": "¿Autoinmunidad activa, trasplante u otra condición contraindica cemiplimab?",
   "motivo": "Contraindicación mayor para anti-PD-1."
  },
  {
   "key": "contra_hhi",
   "cuando": {
    "campo": "hhi_apto",
    "present": true
   },
   "bloquea": [
    "vismo_soni_bcc"
   ],
   "instrucciones": "¿Embarazo, intolerancia severa o fragilidad hacen inseguro vismodegib/sonidegib?",
   "motivo": "Inhibidor Hedgehog no seguro."
  }
 ],
 "avisos": [
  {
   "cuando": [
    {
     "campo": "situacion",
     "in": [
      "localmente_avanzado",
      "metastasico"
     ]
    },
    {
     "campo": "hhi_previo",
     "missing": true
    }
   ],
   "texto": "Debe documentarse si recibió inhibidor Hedgehog antes de cemiplimab."
  }
 ],
