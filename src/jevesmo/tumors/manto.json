{
 "id": "manto",
 "nombre": "Linfoma de células del manto",
 "grupo": "Hematología",
 "version": "MCL-ESMO-2025.1",
 "guias": [
  {
   "titulo": "ESMO Clinical Practice Guideline: Lymphomas",
   "anio": 2025,
   "url": "https://www.esmo.org/guidelines/esmo-clinical-practice-guideline-lymphomas"
  }
 ],
 "descripcion": "Linfoma del manto: estadio, fitness, TP53, inducción con citarabina/ibrutinib (TRIANGLE), BR/R-BAC, mantenimiento, BTKi, pirtobrutinib y brexu-cel.",
 "campos": [
  {
   "id": "estadio",
   "label": "Estadio Ann Arbor/Lugano",
   "tipo": "choice",
   "opciones": [
    "I_II_localizado",
    "III_IV"
   ],
   "requerido": true,
   "pregunta": "¿Cuál es el estadio Ann Arbor/Lugano (localizado I-II o avanzado III-IV)?"
  },
  {
   "id": "mipi",
   "label": "MIPI",
   "tipo": "choice",
   "opciones": [
    "bajo",
    "intermedio",
    "alto"
   ],
   "requerido": true,
   "pregunta": "¿Cuál es el MIPI?"
  },
  {
   "id": "tp53_alterado",
   "label": "TP53 mutado/delecion o cariotipo complejo",
   "tipo": "bool",
   "seccion": "Biología"
  },
  {
   "id": "blastoid_pleomorphic",
   "label": "Variante blastoide/pleomorfica",
   "tipo": "bool",
   "seccion": "Biología"
  },
  {
   "id": "candidato_intensivo",
   "label": "Joven/fit para citarabina intensiva",
   "tipo": "bool",
   "requerido": true,
   "pregunta": "¿Es joven/fit para inducción intensiva con citarabina y TAPH?"
  },
  {
   "id": "candidato_taph",
   "label": "Candidato a TAPH",
   "tipo": "bool",
   "seccion": "Fitness"
  },
  {
   "id": "candidato_car_t",
   "label": "Candidato a CAR-T",
   "tipo": "bool",
   "seccion": "Recaída"
  },
  {
   "id": "btk_previo",
   "label": "Exposición previa a BTKi",
   "tipo": "bool",
   "seccion": "Recaída"
  },
  {
   "id": "cardiopatia_anticoagulacion",
   "label": "Cardiopatía/anticoagulacion",
   "tipo": "bool",
   "seccion": "Seguridad"
  }
 ],
 "derivados": [
  {
   "id": "situacion",
   "label": "Situación clínica",
   "defecto": "primera_linea",
   "reglas": [
    {
     "cuando": {
      "campo": "lineas_previas",
      "gte": 2
     },
     "valor": "segunda_recaida_o_mas"
    },
    {
     "cuando": {
      "campo": "lineas_previas",
      "eq": 1
     },
     "valor": "primera_recaida"
    }
   ]
  }
 ],
 "opciones": [
  {
   "id": "rt_localizado",
   "label": "Radioterapia local +/- inmunoquimioterapia breve",
   "nota": "ESMO MCL: estadio I/II localizado raro -> RT involucrada con/sin R-CHOP/BR según riesgo",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "primera_linea"
    },
    {
     "campo": "estadio",
     "eq": "I_II_localizado"
    }
   ],
   "componentes": [
    "radioterapia",
    "quimioterapia",
    "inmunoterapia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "triangle_intensivo",
   "label": "Inducción intensiva con citarabina + rituximab +/- ibrutinib (TRIANGLE) + TAPH/mantenimiento",
   "nota": "ESMO MCL: joven/fit avanzado, TP53 no alterado -> citarabina/rituximab, considerar ibrutinib según TRIANGLE, TAPH y mantenimiento",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "primera_linea"
    },
    {
     "campo": "estadio",
     "eq": "III_IV"
    },
    {
     "campo": "candidato_intensivo",
     "eq": true
    },
    {
     "not": {
      "campo": "tp53_alterado",
      "eq": true
     }
    }
   ],
   "componentes": [
    "quimioterapia",
    "inmunoterapia",
    "dirigida",
    "trasplante"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "br_mantenimiento",
   "label": "Bendamustina-rituximab + mantenimiento rituximab",
   "nota": "ESMO MCL: no candidato a intensivo/TAPH -> BR seguido de mantenimiento si responde",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "primera_linea"
    },
    {
     "campo": "estadio",
     "eq": "III_IV"
    },
    {
     "campo": "candidato_intensivo",
     "eq": false
    },
    {
     "not": {
      "campo": "tp53_alterado",
      "eq": true
     }
    }
   ],
   "componentes": [
    "quimioterapia",
    "inmunoterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "r_bac",
   "label": "R-BAC (rituximab-bendamustina-citarabina) adaptado",
   "nota": "ESMO MCL: pacientes mayores fit seleccionados pueden beneficiarse de citarabina atenuada R-BAC",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "primera_linea"
    },
    {
     "campo": "estadio",
     "eq": "III_IV"
    },
    {
     "campo": "candidato_intensivo",
     "eq": false
    },
    {
     "campo": "edad",
     "lt": 75
    }
   ],
   "componentes": [
    "quimioterapia",
    "inmunoterapia"
   ],
   "evidencia": "II, B"
  },
  {
   "id": "tp53_ensayo_btk",
   "label": "Ensayo clínico / BTKi-combinacion en TP53 alterado",
   "nota": "ESMO MCL: TP53 alterado/blastoide responde mal a quimio; priorizar ensayo, BTKi-combinaciones o estrategias no quimioterápicas",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "primera_linea"
    },
    {
     "any": [
      {
       "campo": "tp53_alterado",
       "eq": true
      },
      {
       "campo": "blastoid_pleomorphic",
       "eq": true
      }
     ]
    }
   ],
   "componentes": [
    "dirigida",
    "inmunoterapia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "btki_recaida",
   "label": "BTKi covalente (acalabrutinib/zanubrutinib/ibrutinib)",
   "nota": "ESMO MCL: primera recaída tras inmunoquimioterapia y sin BTKi previo -> BTKi es estándar",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "primera_recaida"
    },
    {
     "not": {
      "campo": "btk_previo",
      "eq": true
     }
    },
    {
     "not": {
      "campo": "cardiopatia_anticoagulacion",
      "eq": true
     }
    }
   ],
   "componentes": [
    "dirigida"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "pirtobrutinib",
   "label": "Pirtobrutinib tras BTKi covalente",
   "nota": "ESMO/actualizacion MCL: progresión tras BTKi covalente -> pirtobrutinib si disponible o ensayo",
   "cuando": [
    {
     "campo": "situacion",
     "in": [
      "primera_recaida",
      "segunda_recaida_o_mas"
     ]
    },
    {
     "campo": "btk_previo",
     "eq": true
    }
   ],
   "componentes": [
    "dirigida"
   ],
   "evidencia": "II, B"
  },
  {
   "id": "brexu_cel",
   "label": "Brexucabtagene autoleucel CAR-T",
   "nota": "ESMO MCL: recaída/refractario tras BTKi y candidato -> brexu-cel (ZUMA-2)",
   "cuando": [
    {
     "campo": "situacion",
     "in": [
      "primera_recaida",
      "segunda_recaida_o_mas"
     ]
    },
    {
     "campo": "btk_previo",
     "eq": true
    },
    {
     "campo": "candidato_car_t",
     "eq": true
    }
   ],
   "componentes": [
    "celular"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "lenalidomida_rituximab",
   "label": "Lenalidomida-rituximab / temsirolimus paliativo",
   "nota": "ESMO MCL: recaída no candidata a BTKi/CAR-T o líneas tardías -> inmunomodulador u otra terapia paliativa",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "segunda_recaida_o_mas"
    }
   ],
   "componentes": [
    "dirigida",
    "inmunoterapia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "soporte_manto",
   "label": "Soporte exclusivo o tratamiento muy atenuado",
   "nota": "ESMO MCL: fragilidad extrema/no candidato a terapia activa -> soporte y control sintomático",
   "cuando": [
    {
     "campo": "ecog",
     "in": [
      "3",
      "4"
     ]
    },
    {
     "campo": "candidato_intensivo",
     "eq": false
    }
   ],
   "componentes": [
    "soporte"
   ],
   "evidencia": "V, B"
  }
 ],
 "preguntas": [
  {
   "key": "fit_intensivo_limite",
   "tipo": "noul",
   "capa": 1,
   "cuando": {
    "campo": "candidato_intensivo",
