{
 "id": "vulva",
 "nombre": "Carcinoma escamoso de vulva",
 "grupo": "Ginecológico",
 "version": "VULVA-ESMO-2023.1",
 "guias": [
  {
   "titulo": "ESGO Guidelines for the Management of Patients with Vulvar Cancer - Update 2023",
   "anio": 2023,
   "url": "https://www.esmo.org/guidelines/gynaecological-cancers"
  },
  {
   "titulo": "Vulvar cancer: ESMO Clinical Practice Guidelines for diagnosis, treatment and follow-up",
   "anio": 2017,
   "url": "https://www.esmo.org/guidelines/gynaecological-cancers/vulvar-cancer"
  }
 ],
 "descripcion": "Carcinoma escamoso de vulva: cirugía local, ganglio centinela, linfadenectomía, RT/QRT adyuvante y avanzado.",
 "campos": [
  {
   "id": "estadio",
   "label": "Estadio FIGO",
   "tipo": "choice",
   "opciones": [
    "I",
    "II",
    "III",
    "IVA",
    "IVB_recurrente"
   ],
   "requerido": true,
   "pregunta": "¿Cuál es el estadio FIGO?"
  },
  {
   "id": "histologia",
   "label": "Histología",
   "tipo": "choice",
   "opciones": [
    "escamoso",
    "melanoma",
    "paget",
    "otro"
   ],
   "requerido": true,
   "pregunta": "¿Cuál es la histología?"
  },
  {
   "id": "tamano_cm",
   "label": "Tamaño tumoral",
   "tipo": "number",
   "min": 0,
   "max": 20,
   "unidad": "cm"
  },
  {
   "id": "profundidad_mm",
   "label": "Profundidad de invasión",
   "tipo": "number",
   "min": 0,
   "max": 50,
   "unidad": "mm"
  },
  {
   "id": "unifocal",
   "label": "Tumor unifocal",
   "tipo": "bool"
  },
  {
   "id": "ganglios_clinicos",
   "label": "Ganglios inguinales sospechosos",
   "tipo": "bool"
  },
  {
   "id": "ganglios_positivos",
   "label": "Ganglios positivos patológicos",
   "tipo": "choice",
   "opciones": [
    "ninguno",
    "uno",
    "multiples",
    "extranodal",
    "desconocido"
   ]
  },
  {
   "id": "margenes",
   "label": "Margenes quirúrgicos",
   "tipo": "choice",
   "opciones": [
    "negativos",
    "proximos",
    "positivos",
    "no_operada"
   ]
  },
  {
   "id": "resecable",
   "label": "Resecable sin exenteración mutilante",
   "tipo": "bool",
   "requerido_si": {
    "campo": "estadio",
    "in": [
     "IVA",
     "IVB_recurrente"
    ]
   },
   "pregunta": "En enfermedad avanzada/recurrente, ¿es resecable sin exenteración mutilante?"
  }
 ],
 "derivados": [
  {
   "id": "candidata_gcentinela",
   "label": "Candidata a ganglio centinela",
   "defecto": false,
   "reglas": [
    {
     "cuando": [
      {
       "campo": "estadio",
       "eq": "I"
      },
      {
       "campo": "histologia",
       "eq": "escamoso"
      },
      {
       "campo": "tamano_cm",
       "lt": 4
      },
      {
       "campo": "unifocal",
       "eq": true
      },
      {
       "campo": "ganglios_clinicos",
       "eq": false
      },
      {
       "campo": "profundidad_mm",
       "gt": 1
      }
     ],
     "valor": true
    }
   ]
  }
 ],
 "opciones": [
  {
   "id": "escision_local_ia",
   "label": "Escisión local amplia sin estadiaje ganglionar",
   "nota": "ESGO/ESMO: lesión escamosa IA con invasión <=1 mm tiene riesgo ganglionar despreciable; escisión local con margenes adecuados.",
   "cuando": [
    {
     "campo": "estadio",
     "eq": "I"
    },
    {
     "campo": "profundidad_mm",
     "lte": 1
    }
   ],
   "componentes": [
    "cirugia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "escision_ganglio_centinela",
   "label": "Escisión radical local + ganglio centinela",
   "nota": "ESGO/ESMO: tumor unifocal <4 cm, invasión >1 mm, ganglios clinicamente negativos -> biopsia de ganglio centinela.",
   "cuando": {
    "campo": "candidata_gcentinela",
    "eq": true
   },
   "componentes": [
    "cirugia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "escision_linfadenectomia",
   "label": "Escisión radical local + linfadenectomía inguinofemoral",
   "nota": "ESGO/ESMO: tumor >=4 cm, multifocal o ganglios sospechosos/no candidato a centinela -> linfadenectomía inguinofemoral.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "I",
      "II",
      "III"
     ]
    },
    {
     "any": [
      {
       "campo": "tamano_cm",
       "gte": 4
      },
      {
       "campo": "unifocal",
       "eq": false
      },
      {
       "campo": "ganglios_clinicos",
       "eq": true
      }
     ]
    }
   ],
   "componentes": [
    "cirugia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "rt_adyuvante_margenes",
   "label": "Radioterapia adyuvante al lecho vulvar",
   "nota": "ESGO/ESMO: margenes positivos o muy proximos si no es posible re-escision -> radioterapia adyuvante al lecho tumoral.",
   "cuando": {
    "campo": "margenes",
    "in": [
     "positivos",
     "proximos"
    ]
   },
   "componentes": [
    "radioterapia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "rt_inguinal_adyuvante",
   "label": "Radioterapia inguinofemoral/pelvica adyuvante",
   "nota": "ESGO/ESMO: ganglio centinela macrometastásico, multiples ganglios o factores de alto riesgo -> radioterapia nodal adyuvante.",
   "cuando": {
    "campo": "ganglios_positivos",
    "in": [
     "uno",
     "multiples"
    ]
   },
   "componentes": [
    "radioterapia"
   ],
   "evidencia": "II, B"
  },
  {
   "id": "qrt_adyuvante_extranodal",
   "label": "Quimiorradioterapia adyuvante",
   "nota": "ESGO/ESMO: extensión extranodal o enfermedad ganglionar voluminosa/alto riesgo -> considerar quimiorradioterapia adyuvante.",
   "cuando": {
    "campo": "ganglios_positivos",
    "eq": "extranodal"
   },
   "componentes": [
    "quimiorradioterapia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "qrt_definitiva_avanzada",
   "label": "Quimiorradioterapia definitiva/neoadyuvante",
   "nota": "ESGO/ESMO: enfermedad localmente avanzada no resecable sin gran mutilación -> QRT definitiva o neoadyuvante para preservar órganos.",
   "cuando": [
    {
     "campo": "estadio",
     "eq": "IVA"
    },
    {
     "campo": "resecable",
     "eq": false
    }
   ],
   "componentes": [
    "quimiorradioterapia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "cirugia_avanzada_resecable",
   "label": "Cirugía radical individualizada +- reconstrucción",
   "nota": "ESGO/ESMO: enfermedad localmente avanzada resecable con morbilidad aceptable -> cirugía radical en centro experto, adyuvancia según patología.",
   "cuando": [
    {
     "campo": "estadio",
     "eq": "IVA"
    },
    {
     "campo": "resecable",
     "eq": true
    }
   ],
   "componentes": [
    "cirugia"
   ],
   "evidencia": "IV, B"
  },
  {
   "id": "sistemico_paliativo",
   "label": "Tratamiento sistémico paliativo/ensayo clínico",
   "nota": "ESGO/ESMO: metastásico o recurrente no curable -> quimioterapia basada en platino/taxano, inmunoterapia si biomarcadores, ensayo clínico y objetivos paliativos.",
   "cuando": {
    "campo": "estadio",
    "eq": "IVB_recurrente"
   },
   "componentes": [
    "quimioterapia",
    "inmunoterapia",
    "soporte"
   ],
   "evidencia": "IV, C"
  },
  {
   "id": "soporte_vulva",
   "label": "Soporte, control local de síntomas y cuidados paliativos",
   "nota": "ESGO/ESMO: ECOG 3-4 o enfermedad no candidata a tratamiento activo -> control de dolor, sangrado, infección y soporte integral.",
   "cuando": {
    "campo": "ecog",
    "in": [
     "3",
     "4"
    ]
   },
   "componentes": [
    "soporte",
    "radioterapia"
   ],
   "evidencia": "V, A"
  }
 ],
 "preguntas": [
  {
   "key": "margenes_reescision",
   "tipo": "noul",
   "capa": 1,
   "cuando": {
    "campo": "margenes",
    "in": [
     "positivos",
     "proximos"
    ]
   },
   "instrucciones": "¿Es factible re-escision para obtener margenes adecuados antes de radioterapia?"
  },
  {
   "key": "organ_preservation",
   "tipo": "choice",
   "capa": 1,
   "cuando": {
    "campo": "estadio",
    "eq": "IVA"
   },
   "instrucciones": "Valora preservación de órganos y morbilidad quirúrgica.",
   "criterios": {
    "quirurgica": "Resección factible",
    "qrt": "Cirugía mutilante; preferir QRT"
   }
  },
  {
   "key": "fragilidad",
   "tipo": "noul",
   "capa": 2,
   "cuando": {
    "campo": "ecog",
    "in": [
     "2",
     "3",
     "4"
    ]
