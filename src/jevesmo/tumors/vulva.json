   "instrucciones": "¿La fragilidad limita un tratamiento radical de vulva?"
  }
 ],
 "seguridad": [
  {
   "key": "no_cisplatino_vulva",
   "cuando": {
    "campo": "insuficiencia_renal",
    "eq": true
   },
   "bloquea_componentes": [
    "quimiorradioterapia"
   ],
   "instrucciones": "¿La insuficiencia renal contraindica cisplatino/radiosensibilizacion estándar?",
   "motivo": "Insuficiencia renal limita QRT con cisplatino"
  }
 ],
 "avisos": [
  {
   "cuando": {
    "campo": "ganglios_positivos",
    "eq": "desconocido"
   },
   "texto": "Estado ganglionar desconocido: cambia indicación de RT/QRT."
  },
  {
   "cuando": {
    "campo": "margenes",
    "missing": true
   },
   "texto": "Margenes no informados: pueden modificar indicación de re-escision/RT."
  }
 ],
