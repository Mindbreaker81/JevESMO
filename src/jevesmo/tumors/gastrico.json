  }
 ],
 "descripcion": "Cáncer gástrico/union EG: FLOT +- durvalumab, avanzado según HER2, PD-L1 CPS, MSI-H y Claudin 18.2; 2L ramucirumab-paclitaxel y T-DXd.",
 "campos": [
  {
   "id": "situacion",
   "label": "Situación clínica",
   "tipo": "choice",
   "seccion": "Tumor",
   "opciones": [
    "precoz_endoscopico",
    "localizado_resecable",
    "irresecable_metastasico"
   ],
   "requerido": true,
   "pregunta": "¿Es precoz endoscópico, localizado resecable o irresecable/metastasico?"
  },
  {
   "id": "histologia",
   "label": "Histología",
   "tipo": "choice",
   "seccion": "Tumor",
   "opciones": [
    "adenocarcinoma_intestinal",
    "adenocarcinoma_difuso",
    "mixto_otro"
   ],
   "requerido": true,
   "pregunta": "¿Cuál es la histología del cáncer gástrico?"
  },
  {
   "id": "her2",
   "label": "HER2",
   "tipo": "choice",
   "seccion": "Biomarcadores",
   "opciones": [
    "positivo",
    "negativo",
    "desconocido"
   ]
  },
  {
   "id": "pdl1_cps",
   "label": "PD-L1 CPS",
   "tipo": "number",
   "seccion": "Biomarcadores",
   "min": 0,
   "max": 100
  },
  {
   "id": "msi",
   "label": "MSI/MMR",
   "tipo": "choice",
   "seccion": "Biomarcadores",
   "opciones": [
    "msi_h",
    "pmmr",
    "desconocido"
   ]
  },
  {
   "id": "claudin182",
   "label": "Claudin 18.2",
   "tipo": "choice",
   "seccion": "Biomarcadores",
   "opciones": [
    "positivo",
    "negativo",
    "desconocido"
   ]
  },
  {
   "id": "fevi",
   "label": "FEVI",
   "tipo": "number",
   "seccion": "Seguridad",
   "min": 0,
   "max": 100,
   "unidad": "%"
  },
  {
   "id": "sangrado_activo",
   "label": "Sangrado digestivo activo o alto riesgo",
   "tipo": "bool",
   "seccion": "Seguridad"
  }
 ],
 "derivados": [],
 "opciones": [
  {
   "id": "reseccion_endoscopica",
   "label": "Resección endoscópica",
   "nota": "ESMO: cáncer gástrico muy precoz que cumple criterios endoscópicos puede tratarse con resección endoscópica curativa",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "precoz_endoscopico"
    }
   ],
   "componentes": [
    "cirugia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "flot_perioperatorio",
   "label": "FLOT perioperatorio",
   "nota": "ESMO: adenocarcinoma gástrico/EGJ resecable cT2 o N+ -> FLOT perioperatorio",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "localizado_resecable"
    }
   ],
   "componentes": [
    "quimioterapia",
    "cirugia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "flot_durvalumab_periop",
   "label": "FLOT + durvalumab perioperatorio",
   "nota": "ESMO/Living: resecable de alto riesgo, FLOT + durvalumab puede considerarse donde aprobado (MATTERHORN)",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "localizado_resecable"
    },
    {
     "campo": "pdl1_cps",
     "gte": 1
    }
   ],
   "componentes": [
    "quimioterapia",
    "inmunoterapia",
    "cirugia"
   ],
   "evidencia": "I, B"
  },
  {
   "id": "quimiorradioterapia_postop",
   "label": "Quimiorradioterapia o quimioterapia adyuvante",
   "nota": "ESMO: si cirugía primaria sin perioperatorio, valorar adyuvancia o QRT según margen/ganglios",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "localizado_resecable"
    },
    {
     "campo": "tratamientos_previos",
     "contains": "gastrectomia"
    }
   ],
   "componentes": [
    "quimioterapia",
    "quimiorradioterapia"
   ],
   "evidencia": "I, B"
  },
  {
   "id": "pembro_trastu_quimio_1l",
   "label": "Pembrolizumab + trastuzumab + quimioterapia",
   "nota": "ESMO: avanzado HER2+ 1L -> fluoropirimidina-platino + trastuzumab; añadir pembrolizumab especialmente CPS positivo (KEYNOTE-811)",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "irresecable_metastasico"
    },
    {
     "campo": "her2",
     "eq": "positivo"
    },
    {
     "any": [
      {
       "campo": "lineas_previas",
       "missing": true
      },
      {
       "campo": "lineas_previas",
       "eq": 0
      }
     ]
    }
   ],
   "componentes": [
    "quimioterapia",
    "anti_her2",
    "inmunoterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "ici_quimio_cps",
   "label": "Nivolumab/pembrolizumab + quimioterapia",
   "nota": "ESMO: avanzado HER2 negativo con PD-L1 CPS elevado -> ICI + platino-fluoropirimidina",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "irresecable_metastasico"
    },
    {
     "not": {
      "campo": "her2",
      "eq": "positivo"
     }
    },
    {
     "campo": "pdl1_cps",
     "gte": 5
    },
    {
     "any": [
      {
       "campo": "lineas_previas",
       "missing": true
      },
      {
       "campo": "lineas_previas",
       "eq": 0
      }
     ]
    }
   ],
   "componentes": [
    "quimioterapia",
    "inmunoterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "zolbetuximab_quimio",
   "label": "Zolbetuximab + CAPOX/FOLFOX",
   "nota": "ESMO Living: avanzado HER2 negativo, CLDN18.2 positivo 1L -> zolbetuximab + quimioterapia",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "irresecable_metastasico"
    },
    {
     "not": {
      "campo": "her2",
      "eq": "positivo"
     }
    },
    {
     "campo": "claudin182",
     "eq": "positivo"
    },
    {
     "any": [
      {
       "campo": "lineas_previas",
       "missing": true
      },
      {
       "campo": "lineas_previas",
       "eq": 0
      }
     ]
    }
   ],
   "componentes": [
    "quimioterapia",
    "dirigida"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "ici_msi_h",
   "label": "Inmunoterapia para MSI-H/dMMR",
   "nota": "ESMO: MSI-H/dMMR avanzado tiene alta sensibilidad a PD-1; considerar inmunoterapia",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "irresecable_metastasico"
    },
    {
     "campo": "msi",
     "eq": "msi_h"
    }
   ],
   "componentes": [
    "inmunoterapia"
   ],
   "evidencia": "II, B"
  },
  {
   "id": "quimio_doblete_1l",
   "label": "Quimioterapia platino-fluoropirimidina",
   "nota": "ESMO: avanzado HER2 negativo, PD-L1 bajo o sin biomarcador -> doblete fluoropirimidina-platino",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "irresecable_metastasico"
    },
    {
     "any": [
      {
       "campo": "lineas_previas",
       "missing": true
      },
      {
       "campo": "lineas_previas",
       "eq": 0
      }
     ]
    }
   ],
   "componentes": [
    "quimioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "ram_paclitaxel_2l",
   "label": "Ramucirumab + paclitaxel",
   "nota": "ESMO: 2a línea tras platino-fluoropirimidina -> ramucirumab + paclitaxel (RAINBOW)",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "irresecable_metastasico"
    },
    {
     "campo": "lineas_previas",
     "gte": 1
    }
   ],
   "componentes": [
    "antiangiogenico",
    "quimioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "tdxd_her2_2l",
   "label": "Trastuzumab deruxtecan",
   "nota": "ESMO: avanzado HER2+ tras trastuzumab -> T-DXd en 2a/3a línea (DESTINY-Gastric)",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "irresecable_metastasico"
    },
    {
     "campo": "her2",
     "eq": "positivo"
    },
    {
     "campo": "lineas_previas",
     "gte": 1
    }
   ],
   "componentes": [
    "anti_her2",
    "quimioterapia"
   ],
   "evidencia": "I, B"
  },
  {
   "id": "irinotecan_taxano_2l",
   "label": "Irinotecan o taxano",
   "nota": "ESMO: 2a línea si no candidato a ramucirumab-paclitaxel -> irinotecan, paclitaxel o docetaxel",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "irresecable_metastasico"
    },
    {
     "campo": "lineas_previas",
     "gte": 1
    }
   ],
   "componentes": [
    "quimioterapia"
   ],
   "evidencia": "I, B"
  }
 ],
 "preguntas": [
  {
   "key": "riesgo_periop",
   "tipo": "choice",
   "capa": 1,
   "cuando": {
    "campo": "situacion",
    "eq": "localizado_resecable"
   },
   "instrucciones": "Clasifica el riesgo perioperatorio y la necesidad de intensificar más alla de FLOT estándar",
   "criterios": {
    "estandar": "resecable sin factores de alto riesgo",
    "alto": "bulky N+, T4 o alto riesgo de recaída"
   }
  },
  {
   "key": "beneficio_ici_cps",
   "tipo": "score",
   "capa": 2,
   "cuando": [
    {
     "campo": "situacion",
     "eq": "irresecable_metastasico"
    },
    {
     "campo": "pdl1_cps",
     "gte": 1
    },
    {
     "campo": "pdl1_cps",
     "lt": 5
    }
   ],
   "instrucciones": "PD-L1 CPS bajo: estima beneficio de ICI",
   "criterios": [
    "bajo",
    "incierto",
    "alto"
   ]
  }
 ],
 "seguridad": [
