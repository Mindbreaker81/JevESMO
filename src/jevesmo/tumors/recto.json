{
 "id": "recto",
 "nombre": "Cáncer de recto localizado",
 "grupo": "Digestivo",
 "version": "recto-ESMO-2024.1",
 "guias": [
  {
   "titulo": "ESMO Clinical Practice Guideline: Rectal cancer",
   "anio": 2017,
   "url": "https://www.esmo.org/guidelines/gastrointestinal-cancers/rectal-cancer"
  },
  {
   "titulo": "ESMO Living Guideline: Rectal cancer updates",
   "anio": 2024,
   "url": "https://www.esmo.org/guidelines/gastrointestinal-cancers/rectal-cancer"
  }
 ],
 "descripcion": "Recto localizado por riesgo MRI: cirugía directa, RT corta, QRT larga, TNT, watch and wait y dMMR con dostarlimab/anti-PD-1.",
 "campos": [
  {
   "id": "riesgo_recto",
   "label": "Riesgo MRI/clinico",
   "tipo": "choice",
   "seccion": "Tumor",
   "opciones": [
    "bajo",
    "intermedio",
    "alto",
    "muy_alto",
    "respuesta_clinica_completa"
   ],
   "requerido": true,
   "pregunta": "¿Cuál es el grupo de riesgo local por RM o respuesta completa?"
  },
  {
   "id": "dmmr_msi",
   "label": "dMMR / MSI-H",
   "tipo": "choice",
   "seccion": "Biomarcadores",
   "opciones": [
    "si",
    "no",
    "desconocido"
   ],
   "requerido": true,
   "pregunta": "¿El tumor de recto es dMMR/MSI-H?"
  },
  {
   "id": "amenaza_mrc",
   "label": "Fascia mesorrectal amenazada/CRM+",
   "tipo": "bool",
   "seccion": "Tumor"
  },
  {
   "id": "metastasis_lateral",
   "label": "Ganglios laterales sospechosos",
   "tipo": "bool",
   "seccion": "Tumor"
  },
  {
   "id": "respuesta_clinica_completa",
   "label": "Respuesta clínica completa tras neoadyuvancia",
   "tipo": "bool",
   "seccion": "Tumor"
  },
  {
   "id": "candidato_cirugia_tme",
   "label": "Candidato a TME",
   "tipo": "bool",
   "seccion": "Tumor",
   "requerido": true,
   "pregunta": "¿El paciente es candidato a cirugía TME si esta indicada?"
  },
  {
   "id": "desea_preservacion_organo",
   "label": "Prioridad de preservación de órgano",
   "tipo": "bool",
   "seccion": "Tumor"
  },
  {
   "id": "enfermedad_autoinmune_activa",
   "label": "Enfermedad autoinmune activa",
   "tipo": "bool",
   "seccion": "Seguridad"
  }
 ],
 "opciones": [
  {
   "id": "cirugia_directa_tme",
   "label": "Cirugía directa con TME",
   "nota": "ESMO: recto bajo riesgo (cT1-2/N0 o cT3a-b sin amenazas) -> escisión/TME primaria sin neoadyuvancia.",
   "cuando": [
    {
     "campo": "riesgo_recto",
     "eq": "bajo"
    },
    {
     "campo": "candidato_cirugia_tme",
     "eq": true
    }
   ],
   "componentes": [
    "cirugia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "qrt_larga_intermedio",
   "label": "Quimiorradioterapia larga preoperatoria",
   "nota": "ESMO: riesgo intermedio con necesidad de downstaging o recto bajo -> QRT larga con fluoropirimidina seguida de TME.",
   "cuando": [
    {
     "campo": "riesgo_recto",
     "eq": "intermedio"
    },
    {
     "campo": "candidato_cirugia_tme",
     "eq": true
    }
   ],
   "componentes": [
    "quimiorradioterapia",
    "radioterapia",
    "quimioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "rt_corta_intermedio",
   "label": "Radioterapia corta 5x5 Gy seguida de TME",
   "nota": "ESMO: riesgo intermedio resecable sin necesidad de gran downstaging -> RT corta preoperatoria y cirugía temprana/diferida.",
   "cuando": [
    {
     "campo": "riesgo_recto",
     "eq": "intermedio"
    },
    {
     "campo": "candidato_cirugia_tme",
     "eq": true
    }
   ],
   "componentes": [
    "radioterapia",
    "cirugia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "tnt_alto",
   "label": "Tratamiento neoadyuvante total (TNT)",
   "nota": "ESMO: alto riesgo (cT3c-d/T4, N2, EMVI+, MRF amenazada) -> TNT con quimioterapia sistémica + QRT/RT antes de TME.",
   "cuando": [
    {
     "campo": "riesgo_recto",
     "in": [
      "alto",
      "muy_alto"
     ]
    },
    {
     "not": {
      "campo": "dmmr_msi",
      "eq": "si"
     }
    },
    {
     "campo": "candidato_cirugia_tme",
     "eq": true
    }
   ],
   "componentes": [
    "quimioterapia",
    "radioterapia",
    "quimiorradioterapia",
    "cirugia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "rt_corta_tnt",
   "label": "RT corta seguida de quimioterapia de consolidación",
   "nota": "ESMO/RAPIDO: alto riesgo MRI -> 5x5 Gy seguido de CAPOX/FOLFOX antes de TME es estrategia TNT válida.",
   "cuando": [
    {
     "campo": "riesgo_recto",
     "in": [
      "alto",
      "muy_alto"
     ]
    },
    {
     "not": {
      "campo": "dmmr_msi",
      "eq": "si"
     }
    },
    {
     "campo": "candidato_cirugia_tme",
     "eq": true
    }
   ],
   "componentes": [
    "radioterapia",
    "quimioterapia",
    "cirugia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "qrt_larga_tnt",
   "label": "QRT larga seguida de quimioterapia de consolidación",
   "nota": "ESMO/OPRA: TNT con QRT larga es preferible si se busca downstaging/preservacion esfinteriana.",
   "cuando": [
    {
     "campo": "riesgo_recto",
     "in": [
      "alto",
      "muy_alto"
     ]
    },
    {
     "not": {
      "campo": "dmmr_msi",
      "eq": "si"
     }
    },
    {
     "campo": "candidato_cirugia_tme",
     "eq": true
    }
   ],
   "componentes": [
    "quimiorradioterapia",
    "quimioterapia",
    "cirugia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "dostarlimab_dmmr",
   "label": "Dostarlimab/anti-PD-1 neoadyuvante en dMMR",
   "nota": "ESMO actual: recto localmente avanzado dMMR/MSI-H -> anti-PD-1 neoadyuvante con intención de respuesta completa y preservación.",
   "cuando": [
    {
     "campo": "dmmr_msi",
     "eq": "si"
    },
    {
     "campo": "riesgo_recto",
     "in": [
      "intermedio",
      "alto",
      "muy_alto"
     ]
    }
   ],
   "componentes": [
    "inmunoterapia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "watch_wait",
   "label": "Watch and wait con vigilancia intensiva",
   "nota": "ESMO: tras respuesta clínica completa documentada tras neoadyuvancia, vigilancia no operatoria puede considerarse en centros expertos.",
   "cuando": [
    {
     "any": [
      {
       "campo": "respuesta_clinica_completa",
       "eq": true
      },
      {
       "campo": "riesgo_recto",
       "eq": "respuesta_clinica_completa"
      }
     ]
    },
    {
     "campo": "desea_preservacion_organo",
     "eq": true
    }
   ],
   "componentes": [
    "vigilancia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "tme_post_respuesta",
   "label": "TME tras neoadyuvancia si no respuesta completa",
   "nota": "ESMO: TME sigue estándar tras neoadyuvancia si no se elige watch and wait o respuesta no es completa.",
   "cuando": [
    {
     "campo": "respuesta_clinica_completa",
     "eq": false
    },
    {
     "campo": "candidato_cirugia_tme",
     "eq": true
    },
    {
     "campo": "riesgo_recto",
     "in": [
      "intermedio",
      "alto",
      "muy_alto"
     ]
    }
   ],
   "componentes": [
    "cirugia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "soporte_no_cirugia",
   "label": "Tratamiento no quirúrgico individualizado/soporte",
   "nota": "ESMO: si no candidato a TME, manejo paliativo/local individualizado en MDT.",
   "cuando": [
    {
     "campo": "candidato_cirugia_tme",
     "eq": false
    }
   ],
   "componentes": [
    "soporte"
   ],
   "evidencia": "V, A"
  }
 ],
 "preguntas": [
  {
   "key": "necesita_downstaging",
   "tipo": "noul",
   "capa": 1,
   "cuando": {
    "campo": "riesgo_recto",
    "eq": "intermedio"
   },
   "instrucciones": "¿La localización, margen o necesidad de preservar esfinter justifican QRT larga frente a RT corta/cirugia?"
  },
  {
   "key": "prioridad_preservacion",
   "tipo": "choice",
   "capa": 1,
   "cuando": {
    "campo": "riesgo_recto",
    "in": [
     "alto",
     "muy_alto",
     "respuesta_clinica_completa"
    ]
   },
   "instrucciones": "Valora el objetivo principal.",
   "criterios": {
    "control_local": "Máximo control local con TME",
    "preservacion": "Preservación de órgano/esfinter",
    "sistemico": "Reducir recaída sistémica con TNT"
   }
  },
  {
   "key": "candidato_watch_wait",
   "tipo": "noul",
   "capa": 2,
   "cuando": {
    "campo": "respuesta_clinica_completa",
    "eq": true
   },
   "instrucciones": "¿La respuesta completa esta suficientemente documentada y acepta vigilancia estricta?"
  }
 ],
 "seguridad": [
  {
   "key": "autoinmune_ici",
   "cuando": {
    "campo": "enfermedad_autoinmune_activa",
    "present": true
   },
   "bloquea_componentes": [
    "inmunoterapia"
   ],
   "instrucciones": "Con enfermedad autoinmune activa, ¿anti-PD-1 supone riesgo inaceptable?",
   "motivo": "Riesgo autoinmune alto con inmunoterapia"
  }
 ],
 "avisos": [
  {
   "cuando": {
    "campo": "dmmr_msi",
    "eq": "desconocido"
   },
   "texto": "dMMR/MSI no testado: puede cambiar radicalmente el tratamiento."
