   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "IV",
      "recurrente"
     ]
    },
    {
     "campo": "lineas_previas",
     "gte": 1
    },
    {
     "campo": "molecular",
     "eq": "dMMR"
    }
   ],
   "componentes": [
    "inmunoterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "hormonoterapia",
