    {
     "campo": "estadio",
     "in": [
      "IV",
      "recurrente"
     ]
    },
    {
     "campo": "histologia",
     "eq": "endometrioide"
    },
    {
     "campo": "er_pr_positivo",
     "eq": true
    }
   ],
   "componentes": [
    "hormonal"
   ],
   "evidencia": "III, A"
  },
  {
   "id": "quimio_2l",
   "label": "Quimioterapia paliativa de línea posterior",
   "nota": "ESMO: tras progresión a platino e inmunoterapia/lenvatinib, quimioterapia secuencial o ensayo clínico.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "IV",
      "recurrente"
     ]
    },
    {
     "campo": "lineas_previas",
     "gte": 2
    }
   ],
   "componentes": [
    "quimioterapia"
   ],
   "evidencia": "III, C"
  },
  {
   "id": "soporte_endometrio",
   "label": "Soporte exclusivo/valoracion geriátrica",
