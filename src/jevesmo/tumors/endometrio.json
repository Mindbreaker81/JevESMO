 "guias": [
  {
   "titulo": "ESMO Clinical Practice Guideline: Endometrial cancer",
   "anio": 2024,
   "url": "https://www.esmo.org/guidelines/esmo-clinical-practice-guideline-endometrial-cancer"
  },
  {
   "titulo": "ESGO-ESTRO-ESP guidelines for endometrial carcinoma integrated molecular risk groups",
   "anio": 2021,
   "url": "https://www.esmo.org/guidelines/gynaecological-cancers/endometrial-cancer"
  }
 ],
 "descripcion": "Cáncer de endometrio con clasificación molecular POLE/dMMR/p53abn/NSMP, grupos de riesgo y tratamiento avanzado con quimio-inmunoterapia, lenvatinib-pembrolizumab y hormonoterapia.",
 "campos": [
  {
   "id": "estadio",
   "label": "Estadio FIGO",
   "tipo": "choice",
   "opciones": [
    "I",
    "II",
    "III",
    "IV",
    "recurrente"
   ],
   "requerido": true,
   "pregunta": "¿Cuál es el estadio FIGO o si es enfermedad recurrente?"
  },
  {
   "id": "histologia",
   "label": "Histología",
   "tipo": "choice",
   "opciones": [
    "endometrioide",
    "seroso",
    "celulas_claras",
    "carcinosarcoma",
    "otro"
   ],
   "requerido": true,
   "pregunta": "¿Cuál es la histología?"
  },
  {
   "id": "grado",
   "label": "Grado",
   "tipo": "choice",
   "opciones": [
    "1",
    "2",
    "3"
   ]
  },
  {
   "id": "molecular",
   "label": "Subtipo molecular",
   "tipo": "choice",
   "opciones": [
    "POLEmut",
    "dMMR",
    "p53abn",
    "NSMP",
    "desconocido"
   ],
   "requerido": true,
   "pregunta": "¿Cuál es el subtipo molecular integrado?"
  },
  {
   "id": "riesgo",
   "label": "Grupo de riesgo adyuvante",
   "tipo": "choice",
   "opciones": [
    "bajo",
    "intermedio",
    "alto_intermedio",
    "alto"
   ],
   "requerido_si": {
    "campo": "estadio",
    "in": [
     "I",
     "II",
     "III"
    ]
   },
   "pregunta": "En enfermedad no metastásica, ¿cuál es el grupo de riesgo integrado?"
  },
  {
   "id": "er_pr_positivo",
   "label": "Receptores hormonales positivos",
   "tipo": "bool"
  },
  {
   "id": "candidato_platino",
   "label": "Candidata a carboplatino-paclitaxel",
   "tipo": "bool"
  },
  {
   "id": "hipertension_no_controlada",
   "label": "Hipertensión no controlada",
   "tipo": "bool"
  }
 ],
 "derivados": [
  {
   "id": "ici_subtipo",
   "label": "Sensibilidad esperada a inmunoterapia",
   "defecto": "pMMR_o_desconocido",
   "reglas": [
    {
     "cuando": {
      "campo": "molecular",
      "eq": "dMMR"
     },
     "valor": "dMMR"
    },
    {
     "cuando": {
      "campo": "molecular",
      "eq": "POLEmut"
     },
     "valor": "ultramutado_POLE"
    }
   ]
  }
 ],
 "opciones": [
  {
   "id": "observacion_bajo_riesgo",
   "label": "Observación tras cirugía",
   "nota": "ESMO/ESGO: riesgo bajo, incluido POLEmut temprano o endometrioide IA bajo grado sin factores, no precisa adyuvancia.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "I",
      "II"
     ]
    },
    {
     "campo": "riesgo",
     "eq": "bajo"
    }
   ],
   "componentes": [
    "vigilancia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "braquiterapia_vaginal",
   "label": "Braquiterapia vaginal adyuvante",
   "nota": "ESMO: riesgo intermedio o alto-intermedio seleccionado tras histerectomía -> braquiterapia vaginal.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "I",
      "II"
     ]
    },
    {
     "campo": "riesgo",
     "in": [
      "intermedio",
      "alto_intermedio"
     ]
    }
   ],
   "componentes": [
    "radioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "rt_pelvica",
   "label": "Radioterapia pélvica adyuvante",
   "nota": "ESMO: alto-intermedio con factores sustanciales o estadio II-III puede requerir radioterapia pélvica externa.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "I",
      "II",
      "III"
     ]
    },
    {
     "campo": "riesgo",
     "in": [
      "alto_intermedio",
      "alto"
     ]
    }
   ],
   "componentes": [
    "radioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "quimio_rt_alto_riesgo",
   "label": "Quimioterapia carboplatino-paclitaxel +- radioterapia adyuvante",
   "nota": "ESMO: alto riesgo, estadio III o histologías serosa/celulas claras/carcinosarcoma/p53abn -> quimioterapia con o sin radioterapia.",
   "cuando": [
    {
     "campo": "estadio",
     "eq": "III"
    },
    {
     "campo": "riesgo",
     "eq": "alto"
    }
   ],
   "componentes": [
    "quimioterapia",
    "radioterapia"
   ],
   "evidencia": "I, B"
  },
  {
   "id": "carbo_taxol_ici_dmmr_1l",
   "label": "Carboplatino-paclitaxel + dostarlimab/pembrolizumab (dMMR)",
   "nota": "RUBY/NRG-GY018: enfermedad avanzada o recurrente dMMR/MSI-H candidata a platino -> carboplatino-paclitaxel + anti-PD-1 y mantenimiento.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "IV",
      "recurrente"
     ]
    },
    {
     "campo": "molecular",
     "eq": "dMMR"
    },
    {
     "any": [
      {
       "campo": "lineas_previas",
       "missing": true
      },
      {
       "campo": "lineas_previas",
       "eq": 0
      }
     ]
    }
   ],
   "componentes": [
    "quimioterapia",
    "inmunoterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "carbo_taxol_ici_pmmr_1l",
   "label": "Carboplatino-paclitaxel + pembrolizumab/dostarlimab/durvalumab",
   "nota": "ESMO: enfermedad avanzada/recurrente pMMR/NSMP/p53abn puede recibir quimioterapia con anti-PD-1/PD-L1 y mantenimiento.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "IV",
      "recurrente"
     ]
    },
    {
     "campo": "molecular",
     "in": [
      "NSMP",
      "p53abn",
      "desconocido"
     ]
    },
    {
     "any": [
      {
       "campo": "lineas_previas",
       "missing": true
      },
      {
       "campo": "lineas_previas",
       "eq": 0
      }
     ]
    }
   ],
   "componentes": [
    "quimioterapia",
    "inmunoterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "carbo_taxol_solo",
   "label": "Carboplatino-paclitaxel",
   "nota": "ESMO: si no puede usarse inmunoterapia, carboplatino-paclitaxel es el backbone de primera línea avanzada.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "IV",
      "recurrente"
     ]
    },
    {
     "any": [
      {
       "campo": "lineas_previas",
       "missing": true
      },
      {
       "campo": "lineas_previas",
       "eq": 0
      }
     ]
    },
    {
     "campo": "comorbilidades_relevantes",
     "present": true
    }
   ],
   "componentes": [
    "quimioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "lenvatinib_pembro_2l",
   "label": "Lenvatinib + pembrolizumab",
   "nota": "KEYNOTE-775/ESMO: tras platino en cáncer endometrial pMMR/no dMMR, lenvatinib + pembrolizumab es estándar si tolerable.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "IV",
      "recurrente"
     ]
    },
    {
     "campo": "lineas_previas",
     "gte": 1
    },
    {
     "not": {
      "campo": "molecular",
      "eq": "dMMR"
     }
    }
   ],
   "componentes": [
    "dirigida",
    "inmunoterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "anti_pd1_dmmr_2l",
   "label": "Anti-PD-1 monoterapia",
