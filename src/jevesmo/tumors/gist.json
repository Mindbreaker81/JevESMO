    {
     "campo": "setting_gist",
     "eq": "metastasico"
    },
    {
     "campo": "lineas_previas",
     "gte": 3
    },
    {
     "campo": "progresion_regorafenib",
     "eq": true
    }
   ],
   "componentes": [
    "dirigida"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "ensayo_sdh_wt",
   "label": "Ensayo/estrategia especifica SDH-def/WT",
