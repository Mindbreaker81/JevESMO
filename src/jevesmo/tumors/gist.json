      "SDH_deficiente",
      "wildtype"
     ]
    },
    {
     "campo": "setting_gist",
     "in": [
      "localmente_avanzado",
      "metastasico"
     ]
    }
   ],
   "componentes": [
    "soporte",
    "dirigida"
   ],
   "evidencia": "IV, B"
  }
