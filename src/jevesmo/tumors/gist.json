{
 "id": "gist",
 "nombre": "GIST",
 "grupo": "Digestivo",
 "version": "gist-ESMO-2022.1",
 "guias": [
  {
   "titulo": "ESMO-EURACAN-GENTURIS Clinical Practice Guideline: Gastrointestinal stromal tumours",
   "anio": 2022,
   "url": "https://www.esmo.org/guidelines/gastrointestinal-cancers/gastrointestinal-stromal-tumours"
  }
 ],
 "descripcion": "GIST resecable, riesgo Miettinen, mutaciones KIT/PDGFRA y secuencia imatinib-sunitinib-regorafenib-ripretinib/avapritinib.",
 "campos": [
  {
   "id": "setting_gist",
   "label": "Setting",
   "tipo": "choice",
   "seccion": "Tumor",
   "opciones": [
    "resecable_bajo",
    "resecable_intermedio",
    "resecable_alto",
    "localmente_avanzado",
    "metastasico"
   ],
   "requerido": true,
   "pregunta": "¿El GIST es resecable bajo/intermedio/alto riesgo, localmente avanzado o metastasico?"
  },
  {
   "id": "mutacion",
   "label": "Mutacion driver",
   "tipo": "choice",
   "seccion": "Biomarcadores",
   "opciones": [
    "KIT_exon11",
    "KIT_exon9",
    "PDGFRA_D842V",
    "SDH_deficiente",
    "wildtype",
    "desconocido"
   ],
   "requerido": true,
   "pregunta": "¿Cual es la mutacion principal?"
  },
  {
   "id": "riesgo_miettinen",
   "label": "Riesgo Miettinen/AFIP",
   "tipo": "choice",
   "seccion": "Tumor",
   "opciones": [
    "muy_bajo",
    "bajo",
    "intermedio",
    "alto",
    "desconocido"
   ],
   "requerido": true,
   "pregunta": "¿Cual es el riesgo de recidiva Miettinen/AFIP?"
  },
  {
   "id": "rotura_tumoral",
   "label": "Rotura tumoral",
   "tipo": "bool",
   "seccion": "Tumor"
  },
  {
   "id": "candidato_cirugia",
   "label": "Candidato a cirugia R0",
   "tipo": "bool",
   "seccion": "Tumor",
   "requerido": true,
   "pregunta": "¿Es candidato a reseccion R0 si procede?"
  },
  {
   "id": "progresion_imatinib",
   "label": "Progresion a imatinib",
   "tipo": "bool",
   "seccion": "Tumor"
  },
  {
   "id": "progresion_sunitinib",
   "label": "Progresion a sunitinib",
   "tipo": "bool",
   "seccion": "Tumor"
  },
  {
   "id": "progresion_regorafenib",
   "label": "Progresion a regorafenib",
   "tipo": "bool",
   "seccion": "Tumor"
  },
  {
   "id": "edema_derrame_riesgo",
   "label": "Riesgo de edema/derrame o toxicidad avapritinib",
   "tipo": "bool",
   "seccion": "Seguridad"
  }
 ],
 "opciones": [
  {
   "id": "cirugia_observacion_bajo",
   "label": "Cirugia R0 y observacion",
   "nota": "ESMO: GIST localizado muy bajo/bajo/intermedio riesgo resecable -> reseccion completa sin adyuvancia; vigilancia adaptada.",
   "cuando": [
    {
     "campo": "setting_gist",
     "in": [
      "resecable_bajo",
      "resecable_intermedio"
     ]
    },
    {
     "campo": "riesgo_miettinen",
     "in": [
      "muy_bajo",
      "bajo",
      "intermedio"
     ]
    },
    {
     "campo": "candidato_cirugia",
     "eq": true
    }
   ],
   "componentes": [
    "cirugia",
    "vigilancia"
   ],
   "evidencia": "III, A"
  },
  {
   "id": "imatinib_ady_3y",
   "label": "Imatinib adyuvante 3 anos",
   "nota": "ESMO: GIST resecado de alto riesgo sensible a imatinib -> imatinib 400 mg/dia durante 3 anos.",
   "cuando": [
    {
     "campo": "setting_gist",
     "eq": "resecable_alto"
    },
    {
     "campo": "riesgo_miettinen",
     "eq": "alto"
    },
    {
     "campo": "mutacion",
     "in": [
      "KIT_exon11",
      "KIT_exon9",
      "desconocido"
     ]
    }
   ],
   "componentes": [
    "dirigida"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "imatinib_neoadyuvante",
   "label": "Imatinib neoadyuvante",
   "nota": "ESMO: GIST localmente avanzado/borderline resecable sensible -> imatinib preoperatorio hasta maxima respuesta.",
   "cuando": [
    {
     "campo": "setting_gist",
     "eq": "localmente_avanzado"
    },
    {
     "campo": "mutacion",
     "in": [
      "KIT_exon11",
      "KIT_exon9",
      "desconocido"
     ]
    },
    {
     "campo": "candidato_cirugia",
     "eq": true
    }
   ],
   "componentes": [
    "dirigida",
    "cirugia"
   ],
   "evidencia": "III, A"
  },
  {
   "id": "imatinib_400_1l",
   "label": "Imatinib 400 mg 1L avanzado",
   "nota": "ESMO: GIST metastasico KIT exon 11 u otra mutacion sensible -> imatinib 400 mg/dia indefinido 1L.",
   "cuando": [
    {
     "campo": "setting_gist",
     "eq": "metastasico"
    },
    {
     "campo": "mutacion",
     "in": [
      "KIT_exon11",
      "desconocido",
      "wildtype"
     ]
    },
    {
     "any": [
      {
       "campo": "lineas_previas",
       "missing": true
      },
      {
       "campo": "lineas_previas",
       "eq": 0
      }
     ]
    }
   ],
   "componentes": [
    "dirigida"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "imatinib_800_exon9",
   "label": "Imatinib 800 mg en KIT exon 9",
   "nota": "ESMO: GIST avanzado KIT exon 9 -> dosis alta imatinib 800 mg/dia mejora PFS.",
   "cuando": [
    {
     "campo": "setting_gist",
     "eq": "metastasico"
    },
    {
     "campo": "mutacion",
     "eq": "KIT_exon9"
    },
    {
     "any": [
      {
       "campo": "lineas_previas",
       "missing": true
      },
      {
       "campo": "lineas_previas",
       "eq": 0
      }
     ]
    }
   ],
   "componentes": [
    "dirigida"
   ],
   "evidencia": "I, B"
  },
  {
   "id": "avapritinib_d842v",
   "label": "Avapritinib PDGFRA D842V",
   "nota": "ESMO: GIST PDGFRA D842V avanzado/no resecable -> avapritinib, resistente a imatinib.",
   "cuando": [
    {
     "campo": "mutacion",
     "eq": "PDGFRA_D842V"
    },
    {
     "campo": "setting_gist",
     "in": [
      "localmente_avanzado",
      "metastasico"
     ]
    }
   ],
   "componentes": [
    "dirigida"
   ],
   "evidencia": "III, A"
  },
  {
   "id": "sunitinib_2l",
   "label": "Sunitinib 2L",
   "nota": "ESMO: progresion/intolerancia a imatinib -> sunitinib 2L.",
   "cuando": [
    {
     "campo": "setting_gist",
     "eq": "metastasico"
    },
    {
     "campo": "lineas_previas",
     "gte": 1
    },
    {
     "campo": "progresion_imatinib",
     "eq": true
    }
