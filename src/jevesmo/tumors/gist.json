    {
     "campo": "progresion_sunitinib",
     "eq": true
    }
   ],
   "componentes": [
    "dirigida"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "ripretinib_4l",
   "label": "Ripretinib 4L",
   "nota": "ESMO: progresion a imatinib, sunitinib y regorafenib -> ripretinib 4L.",
