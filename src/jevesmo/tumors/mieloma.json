    }
   ]
  }
 ],
 "opciones": [
  {
   "id": "d_vrd_taph",
   "label": "D-VRd inducción + TAPH + consolidación/mantenimiento lenalidomida",
   "nota": "ESMO/actualizacion: candidato a trasplante -> daratumumab-VRd, TAPH y mantenimiento; PERSEUS/GRIFFIN",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "primera_linea"
    },
    {
     "campo": "candidato_trasplante",
     "eq": true
    }
   ],
   "componentes": [
    "quimioterapia",
    "dirigida",
    "inmunoterapia",
    "trasplante"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "vrd_taph",
   "label": "VRd/VTd inducción + TAPH",
   "nota": "ESMO: si D-VRd no disponible, triplete con bortezomib-lenalidomida-dexametasona o VTd + TAPH",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "primera_linea"
    },
    {
     "campo": "candidato_trasplante",
     "eq": true
    }
   ],
   "componentes": [
    "quimioterapia",
    "dirigida",
    "trasplante"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "drd_no_taph",
   "label": "Daratumumab-lenalidomida-dexametasona (DRd)",
   "nota": "ESMO MAIA: no candidato a trasplante -> DRd hasta progresión si tolerable",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "primera_linea"
    },
    {
     "campo": "candidato_trasplante",
     "eq": false
    }
   ],
   "componentes": [
    "dirigida",
    "inmunoterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "d_vmp_no_taph",
   "label": "Daratumumab-VMP",
   "nota": "ESMO ALCYONE: no candidato a trasplante, especialmente si se prefiere bortezomib/melfalan frente a lenalidomida continua",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "primera_linea"
    },
    {
     "campo": "candidato_trasplante",
     "eq": false
    }
   ],
   "componentes": [
    "quimioterapia",
    "dirigida",
    "inmunoterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "mantenimiento_len",
   "label": "Mantenimiento lenalidomida (considerar bortezomib en alto riesgo)",
   "nota": "ESMO: tras TAPH, mantenimiento lenalidomida; alto riesgo puede requerir proteasoma asociado",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "primera_linea"
    },
    {
     "campo": "candidato_trasplante",
     "eq": true
    },
    {
     "campo": "tratamientos_previos",
     "contains": "TAPH"
    }
   ],
   "componentes": [
    "dirigida"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "recaida_len_sensible",
   "label": "DRd/KRd/Isa-Kd según exposición previa",
   "nota": "ESMO recaída: si no refractario a lenalidomida/anti-CD38, usar tripletes eficaces adaptados a tratamientos previos",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "recaida"
    },
    {
     "not": {
      "campo": "lenalidomida_refractario",
      "eq": true
     }
    },
    {
     "not": {
      "campo": "triple_clase_refractario",
      "eq": true
     }
    }
   ],
   "componentes": [
    "dirigida",
    "inmunoterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "recaida_len_refractario",
   "label": "PVd, KdD o Isa-Kd para lenalidomida-refractario",
   "nota": "ESMO recaída: enfermedad lenalidomida-refractaria tras lenalidomida mantenimiento/DRd -> pomalidomida o carfilzomib con anti-CD38 si sensible",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "recaida"
    },
    {
     "campo": "lenalidomida_refractario",
     "eq": true
    },
    {
     "not": {
      "campo": "triple_clase_refractario",
      "eq": true
     }
    }
   ],
   "componentes": [
    "dirigida",
    "inmunoterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "car_t_bcma",
   "label": "CAR-T BCMA (cilta-cel o ide-cel)",
   "nota": "ESMO/EMA actual: recaída triple-clase expuesta/refractaria y candidato -> CAR-T BCMA con respuestas profundas",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "recaida"
    },
    {
     "campo": "triple_clase_refractario",
     "eq": true
    },
    {
     "campo": "candidato_car_t",
     "eq": true
    }
   ],
   "componentes": [
    "celular"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "biespecifico_bcma_gprc5d",
   "label": "Biespecifico BCMA/GPRC5D (teclistamab, elranatamab, talquetamab)",
   "nota": "ESMO/actualizacion: triple-clase refractario o post-CAR-T -> biespecíficos BCMA o GPRC5D",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "recaida"
    },
    {
     "campo": "triple_clase_refractario",
     "eq": true
    }
   ],
   "componentes": [
    "celular",
    "inmunoterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "paliativo_mieloma",
   "label": "Soporte, radioterapia antiálgica y tratamiento atenuado",
   "nota": "ESMO: fragilidad extrema o no candidato a terapias activas -> soporte, control óseo/dolor e individualización",
   "cuando": [
    {
     "campo": "ecog",
     "in": [
      "3",
      "4"
     ]
    }
   ],
   "componentes": [
    "soporte",
    "radioterapia"
   ],
   "evidencia": "V, B"
  }
 ],
