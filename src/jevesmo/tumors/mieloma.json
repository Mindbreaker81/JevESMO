   "tipo": "bool",
   "seccion": "Seguridad"
  },
  {
   "id": "cardiopatia_carfilzomib",
   "label": "Cardiopatía relevante",
   "tipo": "bool",
   "seccion": "Seguridad"
  }
 ],
