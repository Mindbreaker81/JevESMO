    {
     "campo": "tratamientos_previos",
     "contains": "gemcitabina"
    }
   ],
   "componentes": [
    "quimioterapia"
   ],
   "evidencia": "I, B"
  },
  {
   "id": "folfox_2l",
   "label": "FOLFOX/fluoropirimidina-oxaliplatino 2a linea",
   "nota": "ESMO: tras FOLFIRINOX o gemcitabina, seleccionar regimen alternativo segun toxicidad/exposicion previa",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "metastasico"
    },
    {
     "campo": "lineas_previas",
     "gte": 1
    }
   ],
   "componentes": [
    "quimioterapia"
   ],
   "evidencia": "II, C"
  }
 ],
