  }
 ],
 "descripcion": "Adenocarcinoma pancreatico: resecable, borderline, localmente avanzado y metastasico; mFOLFIRINOX, gem-nab-paclitaxel, NALIRIFOX, adyuvancia y olaparib en gBRCA.",
 "campos": [
  {
   "id": "situacion",
   "label": "Situacion anatomica",
   "tipo": "choice",
   "seccion": "Tumor",
   "opciones": [
    "resecable",
    "borderline",
    "localmente_avanzado",
    "metastasico"
   ],
   "requerido": true,
   "pregunta": "¿El adenocarcinoma pancreatico es resecable, borderline, localmente avanzado o metastasico?"
  },
  {
   "id": "localizacion",
   "label": "Localizacion",
   "tipo": "choice",
   "seccion": "Tumor",
   "opciones": [
    "cabeza",
    "cuerpo_cola"
   ],
   "requerido": true,
   "pregunta": "¿La localizacion principal es cabeza o cuerpo/cola?"
  },
  {
   "id": "brca_germinal",
   "label": "BRCA1/2 germinal",
   "tipo": "bool",
   "seccion": "Biomarcadores"
  },
  {
   "id": "msi",
   "label": "MSI/MMR",
   "tipo": "choice",
   "seccion": "Biomarcadores",
   "opciones": [
    "msi_h",
    "pmmr",
    "desconocido"
   ]
  },
  {
   "id": "respuesta_platino",
   "label": "Respuesta/estabilidad tras platino >=16 semanas",
   "tipo": "bool",
   "seccion": "Historial"
  },
  {
   "id": "bilirrubina_alta",
   "label": "Bilirrubina elevada/obstruccion no drenada",
   "tipo": "bool",
   "seccion": "Seguridad"
  },
  {
   "id": "neuropatia_grado",
   "label": "Neuropatia periferica grado",
   "tipo": "number",
   "seccion": "Seguridad",
   "min": 0,
   "max": 4
  }
 ],
 "derivados": [],
 "opciones": [
  {
   "id": "cirugia_ady_mfolfirinox",
   "label": "Cirugia seguida de mFOLFIRINOX adyuvante",
   "nota": "ESMO: resecable y fit -> reseccion upfront y adyuvancia mFOLFIRINOX 6 meses (PRODIGE 24)",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "resecable"
    },
    {
     "campo": "ecog",
     "in": [
      "0",
      "1"
     ]
    }
   ],
   "componentes": [
    "cirugia",
    "quimioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "ady_gem_cap",
   "label": "Cirugia + gemcitabina-capecitabina/gemcitabina adyuvante",
   "nota": "ESMO: resecable pero no candidato a mFOLFIRINOX -> adyuvancia gemcitabina-capecitabina o gemcitabina",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "resecable"
    }
   ],
   "componentes": [
    "cirugia",
    "quimioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "neoady_mfolfirinox_borderline",
   "label": "mFOLFIRINOX neoadyuvante en borderline",
   "nota": "ESMO: borderline resecable -> neoadyuvancia con mFOLFIRINOX y reevaluacion para cirugia",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "borderline"
    },
    {
     "campo": "ecog",
     "in": [
      "0",
      "1"
     ]
    }
   ],
   "componentes": [
    "quimioterapia",
    "cirugia"
   ],
   "evidencia": "II, B"
  },
  {
   "id": "gemnab_neoady_borderline",
   "label": "Gemcitabina + nab-paclitaxel neoadyuvante",
   "nota": "ESMO: borderline si no candidato a mFOLFIRINOX -> gemcitabina + nab-paclitaxel y reevaluacion",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "borderline"
    }
   ],
   "componentes": [
    "quimioterapia",
    "cirugia"
   ],
   "evidencia": "II, B"
  },
  {
   "id": "induccion_local_avanzado",
   "label": "Quimioterapia de induccion para localmente avanzado",
   "nota": "ESMO: localmente avanzado no metastasico -> FOLFIRINOX o gem-nab de induccion; valorar consolidacion/cirugia si respuesta",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "localmente_avanzado"
    }
   ],
   "componentes": [
    "quimioterapia"
   ],
   "evidencia": "II, B"
  },
  {
   "id": "quimiorradio_consolidacion",
   "label": "Quimiorradioterapia/SBRT de consolidacion",
   "nota": "ESMO: localmente avanzado con control tras induccion -> considerar RT/QRT de consolidacion en seleccionados",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "localmente_avanzado"
    },
    {
     "campo": "tratamientos_previos",
     "contains": "induccion"
    }
   ],
   "componentes": [
    "radioterapia",
    "quimiorradioterapia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "mfolfirinox_1l",
   "label": "mFOLFIRINOX 1a linea metastasico",
   "nota": "ESMO: metastasico ECOG 0-1 y fit -> mFOLFIRINOX primera linea",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "metastasico"
    },
    {
     "campo": "ecog",
     "in": [
      "0",
      "1"
     ]
    },
    {
     "any": [
      {
       "campo": "lineas_previas",
       "missing": true
      },
      {
       "campo": "lineas_previas",
       "eq": 0
      }
     ]
    }
   ],
   "componentes": [
    "quimioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "nalirifox_1l",
   "label": "NALIRIFOX 1a linea metastasico",
   "nota": "ESMO/updates: metastasico fit puede recibir NALIRIFOX como alternativa intensiva 1L",
