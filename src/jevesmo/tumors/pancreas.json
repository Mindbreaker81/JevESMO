   "componentes": [
    "quimioterapia"
   ],
   "evidencia": "I, B"
  },
  {
   "id": "gemnab_1l",
   "label": "Gemcitabina + nab-paclitaxel 1a linea",
   "nota": "ESMO: metastasico, especialmente si no candidato a FOLFIRINOX intensivo -> gemcitabina + nab-paclitaxel",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "metastasico"
    },
    {
     "any": [
      {
       "campo": "lineas_previas",
       "missing": true
      },
      {
       "campo": "lineas_previas",
       "eq": 0
      }
     ]
    }
   ],
   "componentes": [
    "quimioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "olaparib_mantenimiento",
   "label": "Olaparib mantenimiento",
