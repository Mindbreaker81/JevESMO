   "componentes": [
    "inmunoterapia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "naliri_5fu_2l",
   "label": "Nal-IRI + 5-FU/LV 2a linea",
   "nota": "ESMO: tras gemcitabina en metastasico -> liposomal irinotecan + 5-FU/LV (NAPOLI-1)",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "metastasico"
    },
    {
     "campo": "lineas_previas",
     "gte": 1
