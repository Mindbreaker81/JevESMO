{
 "id": "timo",
 "nombre": "Timoma y carcinoma tímico",
 "grupo": "Torácico",
 "version": "TIMO-ESMO-2025.1",
 "guias": [
  {
   "titulo": "Thymic epithelial tumours: ESMO Clinical Practice Guidelines",
   "anio": 2021,
   "url": "https://www.esmo.org/guidelines/lung-and-chest-tumours/thymic-epithelial-tumours"
  },
  {
   "titulo": "ESMO Interactive Guidelines: thymic epithelial tumours",
   "anio": 2025,
   "url": "https://interactiveguidelines.esmo.org/esmo-web-app/toc/index.php?subjectAreaId=1"
  }
 ],
 "descripcion": "Tumores epiteliales tímicos por histología, estadio Masaoka-Koga/TNM, resecabilidad y línea.",
 "campos": [
  {
   "id": "histologia",
   "label": "Histología",
   "tipo": "choice",
   "opciones": [
    {
     "id": "timoma",
     "label": "timoma"
    },
    {
     "id": "carcinoma_timico",
     "label": "carcinoma tímico"
    }
   ],
   "requerido": true,
   "pregunta": "¿Es timoma o carcinoma tímico?"
  },
  {
   "id": "estadio",
   "label": "Estadio Masaoka-Koga/TNM",
   "tipo": "choice",
   "opciones": [
    "I",
    "II",
    "III",
    "IVA",
    "IVB"
   ],
   "requerido": true,
   "pregunta": "¿Cuál es el estadio (I, II, III, IVA o IVB)?"
  },
  {
   "id": "resecable",
   "label": "Resecable R0 esperado",
   "tipo": "bool",
   "requerido": true,
   "pregunta": "¿El tumor es resecable con expectativa de R0?"
  },
  {
   "id": "margen",
   "label": "Margen postoperatorio",
   "tipo": "choice",
   "opciones": [
    "r0",
    "r1",
    "r2",
    "no_operado"
   ],
   "seccion": "Postoperatorio"
  },
  {
   "id": "miastenia_gravis",
   "label": "Miastenia gravis u otra autoinmunidad paraneoplásica",
   "tipo": "bool",
   "seccion": "Seguridad"
  },
  {
   "id": "enfermedad_autoinmune_activa",
   "label": "Enfermedad autoinmune activa",
   "tipo": "bool",
   "seccion": "Seguridad"
  }
 ],
 "derivados": [
  {
   "id": "situacion",
   "label": "Situación",
   "defecto": "avanzado",
   "reglas": [
    {
     "cuando": [
      {
       "campo": "estadio",
       "in": [
        "I",
        "II",
        "III"
       ]
      },
      {
       "campo": "resecable",
       "eq": true
      }
     ],
     "valor": "local resecable"
    },
    {
     "cuando": [
      {
       "campo": "estadio",
       "in": [
        "III",
        "IVA"
       ]
      },
      {
       "campo": "resecable",
       "eq": false
      },
      {
       "any": [
        {
         "campo": "lineas_previas",
         "missing": true
        },
        {
         "campo": "lineas_previas",
         "eq": 0
        }
       ]
      }
     ],
     "valor": "localmente avanzado irresecable"
    },
    {
     "cuando": {
      "campo": "estadio",
      "in": [
       "IVA",
       "IVB"
      ]
     },
     "valor": "avanzado/metastasico"
    }
   ]
  }
 ],
 "opciones": [
  {
   "id": "reseccion_primaria",
   "label": "Resección completa (timectomía) en centro experto",
   "nota": "ESMO: timoma/carcinoma tímico estadio I-II y III resecable -> resección completa R0, evitando ruptura capsular.",
   "cuando": {
    "campo": "situacion",
    "eq": "local resecable"
   },
   "componentes": [
    "cirugia"
   ],
   "evidencia": "III, A"
  },
  {
   "id": "rt_adyuvante_r1_r2_iii",
   "label": "Radioterapia adyuvante",
   "nota": "ESMO: RT postoperatoria indicada tras R1/R2 y considerada en estadio III o carcinoma tímico incluso R0 según riesgo.",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "local resecable"
    },
    {
     "any": [
      {
       "campo": "margen",
       "in": [
        "r1",
        "r2"
       ]
      },
      {
       "campo": "estadio",
       "eq": "III"
      },
      {
       "campo": "histologia",
       "eq": "carcinoma_timico"
      }
     ]
    }
   ],
   "componentes": [
    "radioterapia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "observacion_r0_bajo_riesgo",
   "label": "Vigilancia tras R0 bajo riesgo",
   "nota": "ESMO: timoma estadio I-II completamente resecado R0 sin factores de alto riesgo -> vigilancia sin RT adyuvante.",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "local resecable"
    },
    {
     "campo": "histologia",
     "eq": "timoma"
    },
    {
     "campo": "estadio",
     "in": [
      "I",
      "II"
     ]
    },
    {
     "campo": "margen",
     "eq": "r0"
    }
   ],
   "componentes": [
    "vigilancia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "quimio_induccion",
   "label": "Quimioterapia de inducción CAP/ADOC -> reevaluar cirugía",
   "nota": "ESMO: tumor localmente avanzado potencialmente resecable/irresecable inicial -> quimioterapia de inducción con platino (CAP/ADOC) y reevaluación para resección.",
   "cuando": {
    "campo": "situacion",
    "eq": "localmente avanzado irresecable"
   },
   "componentes": [
    "quimioterapia",
    "cirugia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "quimiorradioterapia_definitiva",
   "label": "Quimiorradioterapia definitiva",
   "nota": "ESMO: enfermedad localmente avanzada no resecable pese a inducción o no quirúrgica -> tratamiento definitivo con QT/RT según tolerancia.",
   "cuando": {
    "campo": "situacion",
    "eq": "localmente avanzado irresecable"
   },
   "componentes": [
    "quimiorradioterapia"
   ],
   "evidencia": "IV, B"
  },
  {
   "id": "platino_avanzado",
   "label": "Quimioterapia basada en platino",
   "nota": "ESMO: timoma o carcinoma tímico avanzado/metastasico primera línea -> combinación basada en platino (CAP/ADOC; carboplatino-paclitaxel en carcinoma).",
   "cuando": [
    {
     "campo": "situacion",
     "eq": "avanzado/metastasico"
    },
    {
     "any": [
      {
       "campo": "lineas_previas",
       "missing": true
      },
      {
       "campo": "lineas_previas",
       "eq": 0
      }
     ]
    }
   ],
   "componentes": [
    "quimioterapia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "pemetrexed_octreotida_timoma",
   "label": "Pemetrexed/everolimus u octreotida-prednisona en timoma",
   "nota": "ESMO: timoma recurrente tras platino -> opciones sistémicas como pemetrexed, everolimus u octreotida-prednisona si receptor positivo.",
   "cuando": [
    {
     "campo": "histologia",
     "eq": "timoma"
    },
    {
     "campo": "lineas_previas",
     "gte": 1
    }
   ],
   "componentes": [
    "quimioterapia",
    "dirigida"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "sunitinib_lenvatinib_carcinoma",
   "label": "Sunitinib o lenvatinib en carcinoma tímico",
   "nota": "ESMO: carcinoma tímico tras quimioterapia basada en platino -> antiangiogénicos multiquinasa sunitinib o lenvatinib.",
   "cuando": [
    {
     "campo": "histologia",
     "eq": "carcinoma_timico"
    },
    {
     "campo": "lineas_previas",
     "gte": 1
    }
   ],
   "componentes": [
    "dirigida",
    "antiangiogenico"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "pembrolizumab_carcinoma",
   "label": "Pembrolizumab en carcinoma tímico seleccionado",
   "nota": "ESMO: carcinoma tímico pretratado puede considerar pembrolizumab solo en ausencia de autoinmunidad y con vigilancia estrecha; no preferido en timoma por toxicidad.",
   "cuando": [
    {
     "campo": "histologia",
     "eq": "carcinoma_timico"
    },
    {
     "campo": "lineas_previas",
     "gte": 1
    },
    {
     "not": {
      "campo": "enfermedad_autoinmune_activa",
      "eq": true
     }
    },
    {
     "not": {
      "campo": "miastenia_gravis",
      "eq": true
     }
    }
   ],
   "componentes": [
    "inmunoterapia"
   ],
   "evidencia": "III, C"
  }
 ],
 "preguntas": [
  {
   "key": "mdt_resecabilidad",
   "tipo": "choice",
   "capa": 1,
   "cuando": {
    "campo": "estadio",
    "in": [
     "III",
     "IVA"
    ]
   },
   "instrucciones": "Valora la estrategia de MDT para enfermedad localmente avanzada.",
   "criterios": {
    "cirugia_directa": "R0 probable de entrada",
    "induccion": "R0 posible tras reducción tumoral",
    "no_quirurgico": "R0 improbable o riesgo excesivo"
   }
  },
  {
   "key": "riesgo_rt",
   "tipo": "score",
   "capa": 2,
   "cuando": {
    "campo": "situacion",
    "eq": "local resecable"
   },
   "instrucciones": "Riesgo de recaída local que justificaria RT adyuvante.",
   "criterios": [
    "bajo",
    "intermedio",
    "alto"
   ]
  },
  {
   "key": "toxicidad_ici_timico",
   "tipo": "noul",
   "capa": 2,
   "cuando": {
    "campo": "lineas_previas",
    "gte": 1
   },
   "instrucciones": "¿Existe riesgo elevado de toxicidad autoinmune con inmunoterapia en tumor tímico?"
  }
 ],
 "seguridad": [
  {
   "key": "autoinmune_ici",
   "cuando": {
    "any": [
     {
      "campo": "miastenia_gravis",
      "eq": true
     },
     {
      "campo": "enfermedad_autoinmune_activa",
      "eq": true
     }
    ]
   },
   "bloquea_componentes": [
    "inmunoterapia"
   ],
   "instrucciones": "Con miastenia/autoinmunidad activa, ¿es inaceptable el riesgo de inmunoterapia?",
   "motivo": "Tumor tímico con autoinmunidad/miastenia: riesgo alto de toxicidad grave por ICI."
  }
 ],
 "avisos": [
  {
   "cuando": {
    "campo": "margen",
    "missing": true
   },
   "texto": "Margen quirúrgico no disponible: condiciona RT adyuvante."
  },
  {
   "cuando": [
    {
     "campo": "lineas_previas",
     "gte": 1
    },
    {
     "campo": "miastenia_gravis",
     "missing": true
    }
   ],
   "texto": "Estado de miastenia/autoinmunidad no documentado: clave antes de inmunoterapia."
  }
 ],
 "vinetas": [
  {
