 "guias": [
  {
   "titulo": "ESMO-EURACAN Clinical Practice Guideline: Nasopharyngeal Carcinoma",
   "anio": 2023,
   "url": "https://www.esmo.org/guidelines/esmo-euracan-clinical-practice-guideline-nasopharyngeal-carcinoma"
  }
 ],
 "descripcion": "Carcinoma nasofaringeo: RT, QRT con cisplatino, induccion gemcitabina-cisplatino y enfermedad recurrente/metastasica.",
 "campos": [
  {
   "id": "estadio",
   "label": "Estadio/situacion",
   "tipo": "choice",
   "seccion": "Tumor",
   "opciones": [
    "I",
    "II",
    "III",
    "IVA",
    "recurrente_metastasico"
   ],
   "requerido": true,
   "pregunta": "¿Cual es el estadio (I, II, III, IVA) o si es recurrente_metastasico?"
  },
  {
   "id": "histologia",
   "label": "Histologia",
   "tipo": "choice",
   "seccion": "Tumor",
   "opciones": [
    "no_queratinizante",
    "queratinizante",
    "indiferenciado"
   ],
   "requerido": true,
   "pregunta": "¿Cual es la histologia del carcinoma nasofaringeo?"
  },
  {
   "id": "ebv_dna_alto",
   "label": "EBV-DNA alto/persistente",
   "tipo": "bool",
   "seccion": "Biomarcadores"
  },
  {
   "id": "cisplatino_apto",
   "label": "Apto para cisplatino",
   "tipo": "bool",
   "seccion": "Seguridad"
  },
  {
   "id": "enfermedad_voluminosa",
   "label": "T/N voluminoso o alto riesgo",
   "tipo": "bool",
   "seccion": "Riesgo"
  },
  {
   "id": "pdl1_expresa",
   "label": "PD-L1 expresado",
   "tipo": "bool",
   "seccion": "Biomarcadores"
  }
 ],
 "derivados": [],
 "opciones": [
  {
   "id": "rt_sola_estadio_i",
   "label": "Radioterapia radical sola",
   "nota": "Estadio I: RT radical IMRT sin quimioterapia.",
   "cuando": {
    "campo": "estadio",
    "eq": "I"
   },
   "componentes": [
    "radioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "qrt_estadio_ii",
   "label": "Quimiorradioterapia concomitante (estadio II)",
   "nota": "Estadio II: RT + cisplatino concomitante, especialmente N1 o factores de riesgo.",
   "cuando": [
    {
     "campo": "estadio",
     "eq": "II"
    },
    {
     "not": {
      "campo": "cisplatino_apto",
      "eq": false
     }
    }
   ],
   "componentes": [
    "quimiorradioterapia",
    "quimioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "rt_estadio_ii_no_cis",
   "label": "RT sola si cisplatino no apto",
   "nota": "Estadio II con cisplatino contraindicado: RT radical e individualizacion.",
   "cuando": [
    {
     "campo": "estadio",
     "eq": "II"
    },
    {
     "campo": "cisplatino_apto",
     "eq": false
    }
   ],
   "componentes": [
    "radioterapia"
   ],
   "evidencia": "II, B"
  },
  {
   "id": "induccion_gp_mas_qrt",
   "label": "Induccion gemcitabina-cisplatino seguida de QRT",
   "nota": "Estadio III-IVA voluminoso/alto riesgo: induccion gemcitabina-cisplatino seguida de QRT.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "III",
      "IVA"
     ]
    },
    {
     "campo": "enfermedad_voluminosa",
     "eq": true
    },
    {
     "not": {
      "campo": "cisplatino_apto",
      "eq": false
     }
    }
   ],
   "componentes": [
    "quimioterapia",
    "quimiorradioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "qrt_definitiva_npc",
   "label": "Quimiorradioterapia definitiva con cisplatino",
   "nota": "Estadio III-IVA no metastasico: QRT concomitante con cisplatino; induccion segun riesgo.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "III",
      "IVA"
     ]
    },
    {
     "not": {
      "campo": "cisplatino_apto",
      "eq": false
     }
    }
   ],
   "componentes": [
    "quimiorradioterapia",
    "quimioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "rt_definitiva_no_cis_npc",
   "label": "RT definitiva si no cisplatino",
   "nota": "Pacientes no candidatos a cisplatino: RT radical e individualizacion.",
   "cuando": [
    {
     "campo": "estadio",
     "in": [
      "III",
      "IVA"
     ]
    },
    {
     "campo": "cisplatino_apto",
     "eq": false
    }
   ],
   "componentes": [
    "radioterapia"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "gem_cis_ici_1l",
   "label": "Gemcitabina-cisplatino + anti-PD-1 1L",
   "nota": "R/M 1L: gemcitabina-cisplatino con toripalimab/camrelizumab u otro anti-PD-1 es estandar actual.",
   "cuando": [
    {
     "campo": "estadio",
     "eq": "recurrente_metastasico"
    },
    {
     "any": [
      {
       "campo": "lineas_previas",
       "missing": true
      },
      {
       "campo": "lineas_previas",
       "eq": 0
      }
     ]
    },
    {
     "not": {
      "campo": "cisplatino_apto",
      "eq": false
     }
    }
   ],
   "componentes": [
    "quimioterapia",
    "inmunoterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "gem_cis_1l",
   "label": "Gemcitabina-cisplatino 1L",
   "nota": "R/M: gemcitabina-cisplatino es doblete de referencia si inmunoterapia no disponible/no adecuada.",
   "cuando": [
    {
     "campo": "estadio",
     "eq": "recurrente_metastasico"
    },
    {
     "any": [
      {
       "campo": "lineas_previas",
       "missing": true
      },
      {
       "campo": "lineas_previas",
       "eq": 0
      }
     ]
    },
    {
     "not": {
      "campo": "cisplatino_apto",
      "eq": false
     }
    }
   ],
   "componentes": [
    "quimioterapia"
   ],
   "evidencia": "I, A"
  },
  {
   "id": "monoquimio_no_platino",
   "label": "Quimioterapia no platino / soporte individualizado",
   "nota": "R/M no candidato a platino: monoterapia paliativa o soporte segun fragilidad.",
   "cuando": [
    {
     "campo": "estadio",
     "eq": "recurrente_metastasico"
    },
    {
     "campo": "cisplatino_apto",
     "eq": false
    }
   ],
   "componentes": [
    "quimioterapia",
    "soporte"
   ],
   "evidencia": "III, B"
  },
  {
   "id": "inmunoterapia_2l_npc",
   "label": "Inmunoterapia anti-PD-1 tras platino",
   "nota": "Tras progresion a platino: anti-PD-1 es opcion en pacientes seleccionados.",
   "cuando": [
    {
     "campo": "estadio",
     "eq": "recurrente_metastasico"
    },
    {
     "campo": "lineas_previas",
     "gte": 1
    }
   ],
   "componentes": [
    "inmunoterapia"
   ],
   "evidencia": "II, B"
  }
 ],
 "preguntas": [
  {
   "key": "riesgo_induccion",
   "tipo": "choice",
   "capa": 1,
   "cuando": {
    "campo": "estadio",
    "in": [
     "III",
     "IVA"
    ]
   },
   "instrucciones": "Clasifica el riesgo de recaida que justifica induccion antes de QRT.",
   "criterios": {
    "alto": "T/N voluminoso, EBV-DNA alto o multiples ganglios",
    "estandar": "Riesgo no voluminoso; QRT directa razonable"
